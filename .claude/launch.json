{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atlas-snap",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd $HOME/atlas-stage/snap && exec python3 srv.py"
      ],
      "port": 8778
    },
    {
      "name": "atlas-pages",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd $HOME/atlas-stage/pages && exec python3 -m http.server 8779 --bind 127.0.0.1"
      ],
      "port": 8779
    },
    {
      "name": "atlas-preview",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd $HOME/atlas-stage/preview && exec python3 -m http.server 8780 --bind 127.0.0.1"
      ],
      "port": 8780
    },
    {
      "name": "reset-claude",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd $HOME/atlas-stage && ATLAS_PROJECT=$HOME/Documents/Claudea exec python3 reset-claude.py --dry --no-open"
      ],
      "port": 8781
    }
  ]
}