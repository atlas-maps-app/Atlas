#
# Atlas truck profile, derived from BRouter's car-vario.brf (MIT, BRouter contributors).
#
# Access follows hgv=* (then motor_vehicle, vehicle, access); destination/delivery/local ways cost extra,
# small and unpaved roads are avoided, height restrictors are forbidden, and the kinematic model gets
# a heavy, tall vehicle. BRouter's data has no maxheight/maxweight/maxwidth/maxlength, so Atlas checks those
# after routing against OpenStreetMap and routes again around conflicts.
#
---model:btools.router.KinematicModel

---context:global

assign validForCars        = true

assign avoid_toll          = false  # %avoid_toll% | Avoid paid roads | boolean
assign avoid_unpaved       = true   # %avoid_unpaved% | Avoid unpaved roads | boolean
assign avoid_motorways     = false  # %avoid_motorways% | Avoid motorways | boolean
assign avoid_ferries       = false  # %avoid_ferries% | Avoid ferries | boolean
assign destination_ok      = false  # %destination_ok% | Allow hgv=destination/delivery ways without a penalty | boolean
assign height_restrictor_ok = false # %height_restrictor_ok% | The vehicle passes under height restrictors | boolean

# Kinematic model parameters: a 40 t articulated truck by default
assign vmax             = 80     # %vmax% | Target speed (in km/h) | number
assign recup_efficiency = 0.5    # %recup_efficiency% | (ratio) | number
assign totalweight      = 40000  # %totalweight% | Total weight (in kg) | number
assign f_roll           = 2350   # %f_roll% | Rolling friction (in Newton) | number
assign f_air            = 3.6    # %f_air% | Drag force (in Newton / (m/s)^2), 0.5*cw*A*rho | number
assign f_recup          = 4000   # %f_recup% | Newton | number
assign p_standby        = 1500   # %p_standby% | Watt | number

assign turnInstructionMode = 1
assign pass1coefficient    = 1.3
assign pass2coefficient    = 1.0

---context:way   # following code refers to way-tags

assign classifier_none        = 1
assign classifier_ferry       = 2

assign is_avoided_toll_road and avoid_toll toll=yes
assign is_avoided_motorway and avoid_motorways highway=motorway|motorway_link

assign isresidentialorliving = or highway=residential|living_street living_street=yes

# road access for a car-like motor vehicle, from the highway class and the generic access keys
assign motoraccess
       switch motor_vehicle=
              switch vehicle=
                     switch access=
                            switch highway=motorway|motorway_link|trunk|trunk_link     1
                            switch highway=primary|primary_link|secondary|secondary_link 1
                            switch highway=tertiary|tertiary_link|unclassified          1
                            switch route=ferry                                          1
                            switch isresidentialorliving                                1
                            switch highway=service                                      1
                            switch highway=track|road                                   1
                            0
                            access=yes|permissive|designated|destination|delivery
                     vehicle=yes|designated|permissive|destination
              motor_vehicle=yes|permissive|designated|destination

assign hgvaccess
       switch hgv=
              motoraccess
              hgv=yes|designated|permissive|destination|delivery|local|unsuitable

assign hgvlimited = or hgv=destination|delivery|local
                       and hgv= or motor_vehicle=destination or vehicle=destination access=destination|delivery

assign initialclassifier =
     if route=ferry then classifier_ferry
     else classifier_none

assign initialcost =
     if      ( and highway= not route=ferry ) then 10000
     else if ( equal initialclassifier classifier_ferry ) then 10000
     else 0

assign accessspeedlimit = if hgvaccess then 999 else 0

assign isbadoneway = if reversedirection=yes then ( if oneway= then junction=roundabout else oneway=yes|true|1 ) else oneway=-1
assign onewayspeedlimit = if isbadoneway then 0 else 999

assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

assign isunpaved = or surface=unpaved|gravel|ground|dirt|grass|sand|earth|mud|clay|rock|stone|pebblestone|fine_gravel|compacted
                      or tracktype=grade2|grade3|grade4|grade5
                         and highway=track surface=

assign maxspeed_surface =
  switch or surface= surface=paved|asphalt|concrete 999
  switch surface=paving_stones|cobblestone|sett 30
  switch isunpaved ( switch avoid_unpaved 1 10 )
  999

assign maxspeed_implicit =
  switch highway=motorway                  999
  switch highway=motorway_link             60
  switch highway=trunk                     999
  switch highway=trunk_link                50
  switch highway=primary|primary_link      80
  switch highway=secondary|secondary_link  70
  switch highway=tertiary|tertiary_link    60
  switch highway=unclassified              45
  switch route=ferry                       10
  switch isresidentialorliving             25
  switch highway=service                   20
  switch highway=track|road                10
  0

assign maxspeed_forward =
  switch maxspeed:forward=50 50
  switch maxspeed:forward=30 30
  switch maxspeed:forward=10 10
  switch maxspeed:forward=20 20
  switch maxspeed:forward=40 40
  switch maxspeed:forward=60 60
  switch maxspeed:forward=70 70
  switch maxspeed:forward=80 80
  switch maxspeed:forward=urban 50
  999

assign maxspeed_backward =
  switch maxspeed:backward=50 50
  switch maxspeed:backward=30 30
  switch maxspeed:backward=10 10
  switch maxspeed:backward=20 20
  switch maxspeed:backward=40 40
  switch maxspeed:backward=60 60
  switch maxspeed:backward=70 70
  switch maxspeed:backward=80 80
  switch maxspeed:backward=urban 50
  999

assign maxspeed_explicit =
  switch maxspeed=50 50
  switch maxspeed=30 30
  switch maxspeed=10 10
  switch maxspeed=20 20
  switch maxspeed=40 40
  switch maxspeed=60 60
  switch maxspeed=70 70
  switch maxspeed=80 80
  switch maxspeed=urban 50
  if reversedirection=yes then maxspeed_backward else maxspeed_forward

assign maxspeed =
  min onewayspeedlimit
  min accessspeedlimit
  min maxspeed_explicit
  min maxspeed_implicit
      maxspeed_surface

# how much a truck dislikes a road class: small roads are slow, tight and often unsuitable
assign classfactor =
  switch highway=motorway|motorway_link|trunk|trunk_link        1.0
  switch highway=primary|primary_link                           1.0
  switch highway=secondary|secondary_link                       1.1
  switch highway=tertiary|tertiary_link                         1.3
  switch highway=unclassified                                   2.0
  switch route=ferry                                            1.0
  switch highway=service                                        4.0
  switch isresidentialorliving                                  ( switch highway=living_street 8.0 3.0 )
  switch highway=track|road                                     10.0
  1.0

assign hgvfactor =
  switch hgv=designated                                         0.9
  switch hgv=unsuitable                                         6.0
  switch and hgvlimited not destination_ok                      5.0
  1.0

assign costfactor =
  if ( equal maxspeed 0 ) then 10000
  else if is_avoided_toll_road then 10000
  else if and avoid_ferries route=ferry then 10000
  else if is_avoided_motorway then 10
  else if and avoid_unpaved isunpaved then 50
  else min 9999 multiply classfactor hgvfactor

assign minspeed = 0

assign priorityclassifier =

  if      ( highway=motorway                  ) then  30
  else if ( highway=motorway_link             ) then  29
  else if ( highway=trunk                     ) then  28
  else if ( highway=trunk_link                ) then  27
  else if ( highway=primary                   ) then  26
  else if ( highway=primary_link              ) then  25
  else if ( highway=secondary                 ) then  24
  else if ( highway=secondary_link            ) then  23
  else if ( highway=tertiary                  ) then  22
  else if ( highway=tertiary_link             ) then  21
  else if ( highway=unclassified              ) then  20
  else if ( isresidentialorliving             ) then  6
  else if ( highway=service                   ) then  6
  else if ( highway=track                     ) then if tracktype=grade1 then 4 else 2
  else if ( highway=bridleway|road            ) then  2
  else 0

assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if or isresidentialorliving highway=service then true
                  else if ( and highway=track tracktype=grade1 ) then true
                  else false

assign classifiermask add          isbadoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                      add multiply isgoodforcars 16
                          multiply isresidentialorliving 32

# keep the tags Atlas reports along the route in the way descriptions
assign atlasspantags = or highway= or surface= or smoothness= or tracktype= or maxspeed= or incline= or lit=
                       or route= or toll= or bridge= or tunnel= or hgv= or lanes= or junction= railway=

---context:node  # following code refers to node tags

assign motoraccess
       switch motor_vehicle=
              switch vehicle=
                     switch access=
                            not barrier=gate|bollard|lift_gate|cycle_barrier|block|chain|bus_trap|spikes|swing_gate|kissing_gate|stile|turnstile
                            access=yes|permissive|designated|destination
                     vehicle=yes|permissive|designated|destination
              motor_vehicle=yes|permissive|designated|destination

assign hgvaccess
       switch hgv=
              motoraccess
              hgv=yes|designated|destination

assign initialcost =
       switch and avoid_toll barrier=toll_booth 1000000
       switch and barrier=height_restrictor not height_restrictor_ok 1000000
       switch hgvaccess
              0
              1000000

assign maxspeed =

       if or crossing=traffic_signals highway=traffic_signals
       then
         switch greater way:priorityclassifier 24 5
         switch greater way:priorityclassifier 22 3
         switch greater way:priorityclassifier 20 1
         0
       else if railway=level_crossing then 0
       else 999

# keep the node tags Atlas reports along the route
assign atlasnodetags = or barrier= or highway= or railway= or ford= traffic_calming=
