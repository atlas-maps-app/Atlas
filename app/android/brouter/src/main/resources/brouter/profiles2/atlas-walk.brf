# Atlas walking profile, derived from BRouter's shortest.brf (MIT, BRouter contributors).
# Foot access only; footways, pedestrian streets and quiet streets are preferred over busy roads,
# and roads whose sidewalk is mapped separately are left to that sidewalk.
# The same file serves wheelchairs: "assign wheelchair = true" forbids steps, raised kerbs, stiles,
# rough surfaces and steep inclines, and makes climbing very expensive.

---context:global

assign validForFoot          = 1

assign wheelchair            = false  # %wheelchair% | Wheelchair: no steps, kerbs, rough surfaces or steep slopes | boolean
assign avoid_steps           = false  # %avoid_steps% | Avoid steps | boolean
assign avoid_ferries         = false  # %avoid_ferries% | Avoid ferries | boolean
assign avoid_unpaved         = false  # %avoid_unpaved% | Avoid unpaved ways | boolean
assign atlas_quiet           = 0      # %atlas_quiet% | 0..1, prefer quiet ways | number
assign atlas_green           = 0      # %atlas_green% | 0..1, prefer parks, forests and water | number
assign atlas_lit             = 0      # %atlas_lit% | 0..1, prefer lit ways | number
assign atlas_flat            = 0      # %atlas_flat% | 0..1, avoid climbing | number

# walking speed for Tobler's hiking function (km/h; about 5 km/h on the flat)
assign maxSpeed              = 6

assign uphillcost            = multiply atlas_flat 60
assign uphillcutoff          = 3
assign downhillcost          = multiply atlas_flat 20
assign downhillcutoff        = 4

assign turnInstructionMode           = 1
assign turnInstructionCatchingRange  = 20
assign turnInstructionRoundabouts    = false
assign considerTurnRestrictions      = false
assign pass1coefficient              = 1.5
assign pass2coefficient              = 1.0

---context:way   # following code refers to way-tags

assign turncost = 0

assign initialclassifier = if route=ferry then 1 else 0
assign initialcost = switch route=ferry 10000 0

assign defaultaccess
       switch access=
              (
                    if motorroad=yes then false
                    else if highway=motorway|motorway_link then false
                    else true
              )
              switch access=private|no
                     false
                     true

assign footaccess
       or bicycle=dismount
          switch foot=
                 defaultaccess
                 not foot=private|no|use_sidepath

assign hassidewalk = sidewalk=both|left|right|yes
assign separatesidewalk = sidewalk=separate

assign isunpaved = or surface=unpaved|gravel|ground|dirt|grass|sand|earth|mud|clay|rock|stone|pebblestone
                      and highway=track|path|bridleway and surface= not tracktype=grade1

# wheelchairs: what is forbidden, and what is merely hard work
assign wheelchairforbidden =
       or highway=steps
       or wheelchair=no
       or sac_scale=hiking|mountain_hiking|demanding_mountain_hiking|alpine_hiking|demanding_alpine_hiking|difficult_alpine_hiking|yes|T1-hiking
       or surface=sand|grass|mud|rock|stone|pebblestone|dirt|earth|ground|clay
       or smoothness=very_bad|horrible|very_horrible|impassable|robust_wheels|high_clearance|off_road_wheels
       or tracktype=grade3|grade4|grade5
          incline=10%|15%|20%|25%|30%|-10%|-15%|-20%|-25%|-30%|steep

assign wheelchairpenalty =
       multiply ( switch surface=gravel|unpaved|compacted|fine_gravel|grass_paver|cobblestone|sett 3 1 )
       multiply ( switch smoothness=bad|poor|rough 3 1 )
       multiply ( switch incline=8%|-8%|up|down|yes 2 1 )
       multiply ( switch wheelchair=yes|designated 0.8 1 )
                ( switch and highway=path|track surface= 2 1 )

assign walkfactor =
       switch highway=pedestrian|footway|living_street|corridor|platform     1.0
       switch highway=steps                                                  1.3
       switch highway=path                                                   ( switch isunpaved 1.1 1.0 )
       switch highway=cycleway                                               ( switch foot=yes|designated|permissive 1.0 1.5 )
       switch highway=primary|primary_link|trunk|trunk_link                  ( switch hassidewalk 1.3 switch separatesidewalk 2.5 1.8 )
       switch highway=secondary|secondary_link                               ( switch hassidewalk 1.2 switch separatesidewalk 2.2 1.6 )
       switch highway=tertiary|tertiary_link                                 ( switch hassidewalk 1.1 switch separatesidewalk 2.0 1.4 )
       switch highway=residential|unclassified|service|road                  ( switch separatesidewalk 1.6 1.05 )
       switch highway=track|bridleway                                        1.1
       switch route=ferry                                                    5.67
       1.2

assign noisepenalty
       switch estimated_noise_class=  0
       switch estimated_noise_class=1 0.1
       switch estimated_noise_class=2 0.3
       switch estimated_noise_class=3 0.6
       switch estimated_noise_class=4 1.0
       switch estimated_noise_class=5 1.5 2.0

assign greenpenalty
       min ( switch estimated_forest_class=  1 switch estimated_forest_class=1 0.8 switch estimated_forest_class=2 0.6
             switch estimated_forest_class=3 0.4 switch estimated_forest_class=4 0.2 switch estimated_forest_class=5 0.1 0 )
           ( switch estimated_river_class=  1 switch estimated_river_class=1 0.8 switch estimated_river_class=2 0.6
             switch estimated_river_class=3 0.4 switch estimated_river_class=4 0.2 switch estimated_river_class=5 0.1 0 )

assign litpenalty = switch lit=yes|sunset-sunrise|24/7|automatic 0 switch lit=no 1 0.3

assign preferencefactor =
       multiply ( add 1 multiply atlas_quiet noisepenalty )
       multiply ( add 1 multiply atlas_green greenpenalty )
       multiply ( add 1 multiply atlas_lit litpenalty )
                ( switch and avoid_unpaved isunpaved 3 1 )

assign costfactor
       if not footaccess then 100000
       else if and wheelchair wheelchairforbidden then 100000
       else if and avoid_steps highway=steps then 100000
       else if and avoid_ferries route=ferry then 100000
       else if and highway= not route=ferry then 100000
       else if highway=motorway|motorway_link|proposed|abandoned|construction|raceway then 100000
       else if sac_scale=demanding_mountain_hiking|alpine_hiking|demanding_alpine_hiking|difficult_alpine_hiking then 100000
       else min 9990 multiply walkfactor
                     multiply preferencefactor
                              ( switch wheelchair wheelchairpenalty 1 )

# way priorities used for voice hint generation

assign isresidentialorliving = or highway=residential|living_street living_street=yes

assign priorityclassifier =

  if      ( highway=motorway                       ) then  30
  else if ( highway=motorway_link                  ) then  29
  else if ( highway=trunk                          ) then  28
  else if ( highway=trunk_link                     ) then  27
  else if ( highway=primary                        ) then  26
  else if ( highway=primary_link                   ) then  25
  else if ( highway=secondary                      ) then  24
  else if ( highway=secondary_link                 ) then  23
  else if ( highway=tertiary                       ) then  22
  else if ( highway=tertiary_link                  ) then  21
  else if ( highway=unclassified                   ) then  20
  else if ( isresidentialorliving                  ) then  6
  else if ( highway=service                        ) then  6
  else if ( highway=cycleway                       ) then  6
  else if ( highway=pedestrian                     ) then  6
  else if ( highway=track                          ) then if tracktype=grade1 then 6 else 4
  else if ( highway=bridleway|road|path|footway    ) then  4
  else if ( highway=steps                          ) then  2
  else 0

assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if ( or isresidentialorliving highway=service ) then true
                  else if ( and highway=track tracktype=grade1 ) then true
                  else false

assign classifiermask add multiply isroundabout   4
                      add multiply islinktype     8
                          multiply isgoodforcars 16

# keep the tags Atlas reports along the route in the way descriptions
assign atlasspantags = or highway= or surface= or smoothness= or tracktype= or cycleway= or bicycle= or maxspeed=
                       or incline= or lit= or waterway= or route= or toll= or bridge= or tunnel= or sidewalk= or embedded_rails= railway=

---context:node  # following code refers to node tags

assign defaultaccess
       switch access=
              1
              switch access=private|no
                     0
                     1

assign footaccess
       or bicycle=dismount
          switch foot=
                 defaultaccess
                 switch foot=private|no
                        0
                        1

assign wheelchairblocked =
       or kerb=raised
       or wheelchair=no
       or barrier=stile|kissing_gate|turnstile|full-height_turnstile|horse_stile|cycle_barrier|motorcycle_barrier
          and barrier=kerb not kerb=lowered|flush|rolled

assign initialcost
       switch footaccess
              ( switch and wheelchair wheelchairblocked 1000000 0 )
              1000000

# keep the node tags Atlas reports along the route
assign atlasnodetags = or barrier= or highway= or railway= or crossing= or kerb= or ford= or traffic_calming= waterway=
