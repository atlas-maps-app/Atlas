# The hashes the emulator run must reproduce, each what the host build computes from the same input. ci/smoke.sh reads
# them (a value the environment sets wins). They live here, not in .github/workflows, so that a change of the engine's
# which moves one edits no workflow file: the nightly alpha's token may not tag a commit whose workflow files differ
# from the default branch's. Change one when its host test names the new value.
# K3b: the host build's and the port's numerics hash
ATLAS_PYMATH_HASH=77476b808456a6f0
# K8: the host build's sun bits of the bundled Westerkerk (sun/Buckets.hpp's bundled_check_expected; SunParityTest holds
# this line to the host build's)
ATLAS_SUN_HASH=6a47c776c64ed9ae
# K9: the host build's ground (stage T) of the bundled Westerkerk
ATLAS_GROUND_HASH=e8916967df166e8a
# the host build's twin check of the bundled Westerkerk (frame/TwinCheck.hpp's twin_check_expected)
ATLAS_TWIN_HASH=9eb7aca8fa4abfd6
