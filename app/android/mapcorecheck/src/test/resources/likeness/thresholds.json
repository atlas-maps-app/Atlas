{
  "about": "plan-vector D16's likeness gates, every one fixed before its first run (K4). Per gate and platform, each metric has `fixed` (written now, from D16's tables, the allowances of N9 and K6's calibration of the adopted coverage variant, msaa4-standard, on amd64, in anchor/src/test/resources/likeness.json), `threshold` (the one in force: never looser than `fixed` unless `history` carries the owner's reason), `measured` and `commit` (the last green run), and `history`. Only the coordinator edits this file; CI proposes tightened values (Ratchet.kt) after a green run on app.",
  "format": 1,
  "stage": "A0",
  "stages": ["A1", "A2", "A3", "A4"],
  "metrics": {
    "mad": "max",
    "within2": "min",
    "p99": "max",
    "block": "max",
    "flat": "max",
    "medianMad": "max",
    "p90Mad": "max",
    "madOverStructural": "max",
    "ownersIoU": "min",
    "labelMissing": "max",
    "labelPx": "max",
    "labelDeg": "max",
    "l1Unmatched": "max",
    "l1StepShare": "max",
    "l2Frame": "max",
    "l2Within2": "min",
    "l2Vertex": "max",
    "fields": "max",
    "l0Records": "max",
    "l0Geometry": "max",
    "l0Bits": "max",
    "popsOverPort": "max",
    "handOverMad": "max",
    "handOverBlock": "max",
    "bandStep": "max"
  },
  "allowance": {
    "about": "the platform allowance (N9): two conformant Vulkan drivers drew one dense frame 0.6-1.0 MAD apart",
    "lavapipe": 0.8,
    "phone": 1.2
  },
  "ratchet": {
    "about": "after a green run on app, CI proposes each threshold tightened to the measured value plus this (never loosened); the coordinator alone commits",
    "mad": 0.1,
    "medianMad": 0.1,
    "p90Mad": 0.1,
    "madOverStructural": 0.1,
    "within2": -0.005,
    "p99": 2,
    "block": 0.5,
    "flat": "x1.5",
    "ownersIoU": -0.01,
    "labelPx": 0.1,
    "labelDeg": 0.1,
    "l2Frame": 0.1,
    "l2Within2": -0.005,
    "popsOverPort": 0.0,
    "handOverMad": 0.1,
    "handOverBlock": 0.5,
    "bandStep": 0.0
  },
  "phoneRule": {
    "about": "a phone's VK check gates: lavapipe-x86_64's plus the difference of the two allowances, its within-2 shares 2 points lower, L2 at the phone's allowance; written per model when its VK facts arrive (`phone:<manufacturer model>/<driver version>`)",
    "mad": 0.4,
    "medianMad": 0.4,
    "p90Mad": 0.4,
    "within2": -0.02,
    "l2Frame": 1.2,
    "l2Within2": 0.92
  },
