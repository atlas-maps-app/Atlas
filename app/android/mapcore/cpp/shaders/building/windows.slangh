// A wall's windows (ENGINE.md step 4, the facades; render/amsterdam.py's _draw_building, its window rows; CP/geometry/
// Walls.hpp's WindowWall), shared by the GPU (shaders/building/draw.slang's windows_cs, window_near_vs,
// window_glass_vs, window_frames_vs) and the twin (CP/twin/building/BuildingShader.hpp compiles it as C++ after
// building.slangh). Not a module: draw.slang includes it after building.slangh.
//
// A windowed wall's record (a uint4 of the walls heap: BuildingWindowWall) names its wall's one-cell primitive, its
// rows (building:levels) and bays, its style and flags, its first window among the tile's (which is its first sample
// in the tile's window group of sun samples: K8's order, the same) and its slots. Its window k = r · cols + c is cut
// from the wall as the port cuts it (building_window_box, building_window_quad):
//   fh = (top - y0) / max(1, levels); ya = y0 + r·fh + fh·(r ? 0.22 : 0.3), yb = ya + fh·(r ? (modern ? 0.62 : 0.58)
//   : 0.5) (Paris: ya = y0 + r·fh + 0.13·fh, yb = ya + 0.73·fh); u0 = (c + (modern ? 0.1 : paris ? 0.31 : 0.28)) /
//   cols, u1 = (c + (modern ? 0.9 : paris ? 0.69 : 0.72)) / cols; its corners quad_at(a, b, ya, yb, u0, u1, 0.04, n),
//   in float.
// Per frame each window is decided once (windows_cs; the twin alike), as the port decides it: its wall's windows are
// drawn where its building's item is drawn in a band with windows (the view's win_d) and its wall turns to the eye,
// but not a church's with weather nearer than 520 m (which takes church windows) nor, with weather, a shop floor's
// first row; the window's corners are clipped at the near plane and projected as Camera.poly does, kept where their
// box reaches within 300 px of the frame and their area is over 0.25 px² (`if sp and area(sp) > 0.25`), and snapped
// at rest; it is lit where the sun is up and its sample's bit is set, else dark.
//
// Close up the port draws more (`deep = wx and d < 160`, its item's depth d): with weather nearer than 160 m a window
// whose shape covers over 70 px² is a hole in the wall, its reveal (that shape, in the wall's colour times 0.55,
// unlit), its glass set back 0.16 m behind the wall and its sill (0.11 m under the window and 0.07 m wider either side,
// 0.07 m out from the wall); every window of such a wall has its frame the wider (0.07 · focal / d, at least 0.7 px).
// Nearer than 140 m, with weather or without, a window whose glass covers over 30 px² has its sash bars: from its
// bottom's middle to its top's and across at 0.42 of its height, 0.01 m out from its glass, their width 0.045 · focal
// / d deep, else 9 / d (at least 0.7 px), butt-capped. The widths come from the CPU (passes::window_widths: the item's
// depth in double, printed to a tenth as the port prints them).
//
// The port paints each wall's windows as five paths: its reveals, its dark windows (fill gd, stroke fr), its lit ones
// (fill gl), its sash bars (stroke fr, no fill) and its sills, the dark and lit paths every window's fill, then every
// window's stroke over the fills (the objects group's round joins). The frame draws each part opaque on its wall's
// plane with a lead of its own over the wall's cells, in the paths' order: the reveal, then the glass, the window
// eroded by the stroke's half width (what the stroke leaves of the fill); its frame, the band between its outline
// dilated by the half width and its glass, in the stroke's colour, so where two windows' frames reach each other's
// glass (a wall seen at a slant) the frame covers it, as the path's strokes cover its fills; the sash bars; the sill.
// The frame's band shares the glass's corners, so the two fit without a crack, and its fragments keep the samples
// within the half width of the window (building_window_covers), the round joins exactly at any width. Under MSAA each
// sample takes what SVG's fill and stroke leave on it. The glass's paint: by day with weather the gradients the port
// defines (`glass`, by the sky's cover; `glassLit`), each over its path's box from top to bottom (objectBoundingBox):
// the wall's dark windows' box, or its lit ones'; else its flat colours.
//
// A houseboat's cabin (draw_houseboat's walls(cab, deck, top, ..., win=True), the boat drawn with weather) has a row
// of panes on each wall over 1.6 m long: k = max(1, int(elen / 1.7)) panes from 0.35 m to 1.0 m above the deck, pane j
// from (j + 0.22) / k to (j + 0.78) / k along the wall, 0.03 m out from it, drawn where its item is nearer than 520 m
// and the wall turns to the eye, each kept within 200 px of the frame where its area is over 0.2 px²: one path at the
// slot after its wall's, the glass's gradient by day (its own colour at night) and its frames .5 px wide in its own
// colours (the style file's `houseboats`). Its windowed wall's style is BUILDING_WINDOW_CABIN, with one row, its panes
// as its bays; they have no sun samples (never lit), so its first window names none.
#pragma once

// A facade wall's record (a uint4): x its wall's one-cell primitive in the tile's edged list (a cabin's wall, for a
// houseboat's cabin: bits 0-23), its style (24-25) and flags (26-31); y its first window among the tile's (its first
// sample in the window group); z its rows (bits 0-11: its windows', or where it has none its storeys for its material
// face), its material face (12-14: BUILDING_MATERIAL_) and its bays (16-31), no bays where it has no windows; w its
// first painter slot within the item, near (bits 0-15) and far (16-31): its shop glazing's where it has one, then its
// material face's (building_material_slots), then its windows': its reveals', its dark windows', its lit ones', its
// sash bars' and its sills'. Its building's plinth's and cornice's slots follow all its walls (each item's word in the
// tile's facades: BUILDING_NO_FACADE where it has neither).
static const uint BUILDING_WINDOW_WALL_BITS = 0x00FFFFFFu;
static const uint BUILDING_WINDOW_LEVELS = 0x0FFFu;
static const uint BUILDING_WINDOW_MATERIAL_SHIFT = 12u;
static const uint BUILDING_WINDOW_STYLE_SHIFT = 24u;
static const uint BUILDING_WINDOW_FLAGS_SHIFT = 26u;
// Its style (geometry/Walls.hpp's WindowStyle) and flags (window_flag).
static const uint BUILDING_WINDOW_PLAIN = 0u;
static const uint BUILDING_WINDOW_MODERN = 1u;
static const uint BUILDING_WINDOW_PARIS = 2u;
static const uint BUILDING_WINDOW_CABIN = 3u;
static const uint BUILDING_WINDOW_SHOP_FLOOR = 1u;
static const uint BUILDING_WINDOW_WAREHOUSE = 2u;
static const uint BUILDING_WINDOW_CHURCH = 4u;
static const uint BUILDING_WINDOW_PLINTH = 8u;
static const uint BUILDING_WINDOW_CORNICE = 16u;
static const uint BUILDING_WINDOW_GLAZING = 32u;
static const uint BUILDING_NO_FACADE = 0xFFFFFFFFu;
// A wall's material face (geometry/Walls.hpp's Material).
static const uint BUILDING_MATERIAL_NONE = 0u;
static const uint BUILDING_MATERIAL_GLASS = 1u;
static const uint BUILDING_MATERIAL_METAL = 2u;
static const uint BUILDING_MATERIAL_BALCONIES = 3u;
static const uint BUILDING_MATERIAL_PARKING = 4u;
// A windowed wall's painter slots within the item, from its first (geometry/Walls.hpp's window_slots): its reveals,
// dark windows, lit ones, sash bars and sills.
static const uint BUILDING_WINDOW_REVEALS = 0u;
static const uint BUILDING_WINDOW_DARK = 1u;
static const uint BUILDING_WINDOW_LIT_SLOT = 2u;
static const uint BUILDING_WINDOW_SASHES = 3u;
static const uint BUILDING_WINDOW_SILLS = 4u;

// The port's constants: the windows' least area (CSS px², exclusive), how far they stand out from their wall (m); a
// deep window's least area for its reveal, its glass's set-back, its sill's drop under the window, its width beyond it
// either side and how far it stands out (m); the sash bars' least area, how far they stand out from the glass (m), and
// the height their cross bar lies at (a fraction of the window's).
static const float BUILDING_WINDOW_MIN_AREA = 0.25f;
static const float BUILDING_WINDOW_OUT = 0.04f;
static const float BUILDING_DEEP_AREA = 70.0f;
static const float BUILDING_GLASS_BACK = -0.16f;
static const float BUILDING_SILL_DROP = 0.11f;
static const float BUILDING_SILL_WIDEN = 0.07f;
static const float BUILDING_SILL_OUT = 0.07f;
static const float BUILDING_SASH_AREA = 30.0f;
static const float BUILDING_SASH_OUT = 0.01f;
static const float BUILDING_SASH_CROSS = 0.42f;
// A facade's flat detail (_draw_building's, with weather): the plinth's height near and far and how far it stands out,
// the cornice's depth down from the wall's top and how far it stands out, their margin (CSS px) and least area; the
// shop glazing's heights from the wall's foot, its span along the wall, how far it stands out and its least area.
static const float BUILDING_PLINTH_LOW = 0.6f;
static const float BUILDING_PLINTH_HIGH = 0.9f;
static const float BUILDING_PLINTH_OUT = 0.02f;
static const float BUILDING_CORNICE_DEPTH = 0.42f;
static const float BUILDING_CORNICE_OUT = 0.05f;
static const float BUILDING_FACADE_MARGIN = 200.0f;
static const float BUILDING_FACADE_AREA = 0.15f;
static const float BUILDING_GLAZING_FROM = 0.65f;
static const float BUILDING_GLAZING_TO = 2.95f;
static const float BUILDING_GLAZING_U0 = 0.05f;
static const float BUILDING_GLAZING_U1 = 0.95f;
static const float BUILDING_GLAZING_OUT = 0.03f;
static const float BUILDING_GLAZING_AREA = 0.4f;
// A houseboat cabin's panes: their heights above the deck, their span along the wall from the start of each of its k
// shares, how far they stand out (m), their margin (CSS px) and least area (CSS px², exclusive).
static const float BUILDING_CABIN_FROM = 0.35f;
static const float BUILDING_CABIN_TO = 1.0f;
static const float BUILDING_CABIN_U0 = 0.22f;
static const float BUILDING_CABIN_U1 = 0.78f;
static const float BUILDING_CABIN_OUT = 0.03f;
static const float BUILDING_CABIN_MARGIN = 200.0f;
static const float BUILDING_CABIN_AREA = 0.2f;

// The windows' leads on their wall's plane (relative to its reciprocal depth, as the cells' and the roofs'), in the
// paths' order from one step past the cells' most (15 steps of 2^-16): the reveals, the glass, the frames, the sash
// bars, the sills; a shop's glazing takes the windows' glass's and frames', a plinth and a cornice the sills' (none of
// them meets another on its wall: with weather the shop floor has no row of windows).
static const float BUILDING_REVEAL_LEAD = 2.44140625e-4f;
static const float BUILDING_GLASS_LEAD = 2.593994140625e-4f;
static const float BUILDING_WINDOW_LEAD = 2.74658203125e-4f;
static const float BUILDING_SASH_LEAD = 2.899169921875e-4f;
static const float BUILDING_SILL_LEAD = 3.0517578125e-4f;
static const float BUILDING_GLAZING_GLASS_LEAD = BUILDING_GLASS_LEAD;
static const float BUILDING_GLAZING_FRAME_LEAD = BUILDING_WINDOW_LEAD;

// The vertices each window draws: its frame (10 triangles at most, a polygon holding its band, which the fragments trim
// to the band: building_window_frame_point) and its glass (as a plain polygon's, through the roofs' fans); each near
// window's reveal, sill (a fan of 3 triangles each) and sash bars (two quads); each facade's plinth and cornice (a fan
// each).
static const uint BUILDING_WINDOW_FRAME_VERTICES = 30u;
static const uint BUILDING_WINDOW_GLASS_VERTICES = 5u;
static const uint BUILDING_WINDOW_NEAR_VERTICES = 30u;
static const uint BUILDING_FACADE_VERTICES = 18u;

struct BuildingWindowWall {
    uint wall;  // its wall's one-cell primitive in the tile's edged list (a houseboat cabin's wall)
    uint style; // BUILDING_WINDOW_PLAIN, _MODERN, _PARIS, _CABIN
    uint flags; // BUILDING_WINDOW_SHOP_FLOOR, _WAREHOUSE, _CHURCH
    uint first; // its first window among the tile's (its first sample in the tile's window group; a cabin's none)
    uint levels;
    uint cols;
    uint near_slot;
    uint far_slot;
    uint material; // BUILDING_MATERIAL_
};

inline BuildingWindowWall building_window_wall(uint4 v) {
    BuildingWindowWall w;
    w.wall = v.x & BUILDING_WINDOW_WALL_BITS;
    w.style = (v.x >> BUILDING_WINDOW_STYLE_SHIFT) & 3u;
    w.flags = (v.x >> BUILDING_WINDOW_FLAGS_SHIFT) & 0x3Fu;
    w.first = v.y;
    w.levels = v.z & BUILDING_WINDOW_LEVELS;
    w.material = (v.z >> BUILDING_WINDOW_MATERIAL_SHIFT) & 7u;
    w.cols = v.z >> 16u;
    w.near_slot = v.w & 0xFFFFu;
    w.far_slot = v.w >> 16u;
    return w;
}

/// Where window r, c of windowed wall `w` lies on its wall's one-cell primitive `wall` (corners (a, y0), (b, y0), (b,
/// top), (a, top)): its heights ya to yb and its span u0 to u1 along the wall, as the port cuts it.
struct BuildingWindowBox {
    float ya;
    float yb;
    float u0;
    float u1;
};

inline BuildingWindowBox building_window_box(BuildingPrim wall, BuildingWindowWall w, uint r, uint c) {
    float y0 = wall.c0.y;
    float top = wall.c3.y;
    float lv = float(w.levels);
    float fh = (top - y0) / (lv > 1.0f ? lv : 1.0f);
    bool modern = w.style == BUILDING_WINDOW_MODERN;
    bool paris = w.style == BUILDING_WINDOW_PARIS;
    float row = y0 + float(r) * fh;
    BuildingWindowBox b;
    b.ya = row + fh * (r != 0u ? 0.22f : 0.3f);
    b.yb = b.ya + fh * (r != 0u ? (modern ? 0.62f : 0.58f) : 0.5f);
    if (paris) {
        b.ya = row + fh * 0.13f;
        b.yb = b.ya + fh * 0.73f;
    }
    float cols = float(w.cols);
    b.u0 = (float(c) + (modern ? 0.1f : (paris ? 0.31f : 0.28f))) / cols;
    b.u1 = (float(c) + (modern ? 0.9f : (paris ? 0.69f : 0.72f))) / cols;
    return b;
}

/// The quad of box `b` on wall `wall` stood out `out` metres along its face's normal `n` (quad_at's corners, in float).
inline BuildingPrim building_window_quad(BuildingPrim wall, float3 n, BuildingWindowBox b, float out) {
    float ex = wall.c1.x - wall.c0.x;
    float ez = wall.c1.z - wall.c0.z;
    float ax = (wall.c0.x + ex * b.u0) + n.x * out;
    float az = (wall.c0.z + ez * b.u0) + n.z * out;
    float bx = (wall.c0.x + ex * b.u1) + n.x * out;
    float bz = (wall.c0.z + ez * b.u1) + n.z * out;
    BuildingPrim p = wall;
    float3 c0 = {ax, b.ya, az};
    float3 c1 = {bx, b.ya, bz};
    float3 c2 = {bx, b.yb, bz};
    float3 c3 = {ax, b.yb, az};
    p.c0 = c0;
    p.c1 = c1;
    p.c2 = c2;
    p.c3 = c3;
    p.flags = 0u;
    p.lead = 0u;
    return p;
}

/// A facade's plinth on wall `wall`, low nearer than 300 m: quad_at(a, b, y0, y0 + (0.6 if d < 300 else 0.9), 0, 1,
/// 0.02, n).
inline BuildingPrim building_plinth(BuildingPrim wall, float3 n, bool low) {
    BuildingWindowBox b;
    b.ya = wall.c0.y;
    b.yb = wall.c0.y + (low ? BUILDING_PLINTH_LOW : BUILDING_PLINTH_HIGH);
    b.u0 = 0.0f;
    b.u1 = 1.0f;
    return building_window_quad(wall, n, b, BUILDING_PLINTH_OUT);
}

/// A facade's cornice on wall `wall`: quad_at(a, b, wall_top - 0.42, wall_top, 0, 1, 0.05, n).
inline BuildingPrim building_cornice(BuildingPrim wall, float3 n) {
    BuildingWindowBox b;
    b.ya = wall.c3.y - BUILDING_CORNICE_DEPTH;
    b.yb = wall.c3.y;
    b.u0 = 0.0f;
    b.u1 = 1.0f;
    return building_window_quad(wall, n, b, BUILDING_CORNICE_OUT);
}

/// A shop floor's glazing on wall `wall`: quad_at(a, b, y0 + 0.65, y0 + 2.95, 0.05, 0.95, 0.03, n).
inline BuildingPrim building_glazing(BuildingPrim wall, float3 n) {
    BuildingWindowBox b;
    b.ya = wall.c0.y + BUILDING_GLAZING_FROM;
    b.yb = wall.c0.y + BUILDING_GLAZING_TO;
    b.u0 = BUILDING_GLAZING_U0;
    b.u1 = BUILDING_GLAZING_U1;
    return building_window_quad(wall, n, b, BUILDING_GLAZING_OUT);
}

/// Window r, c of windowed wall `w` (building_window_box's), stood out along `n` as the port draws it.
inline BuildingPrim building_window_prim(BuildingPrim wall, float3 n, BuildingWindowWall w, uint r, uint c) {
    return building_window_quad(wall, n, building_window_box(wall, w, r, c), BUILDING_WINDOW_OUT);
}

/// The sill of a deep window of box `b`: quad_at(a, b, ya - 0.11, ya, u0 - du, u1 + du, 0.07, n), du = 0.07 / elen.
inline BuildingPrim building_window_sill(BuildingPrim wall, float3 n, BuildingWindowBox b) {
    float ex = wall.c1.x - wall.c0.x;
    float ez = wall.c1.z - wall.c0.z;
    float du = BUILDING_SILL_WIDEN / sqrt(ex * ex + ez * ez);
    BuildingWindowBox s;
    s.ya = b.ya - BUILDING_SILL_DROP;
    s.yb = b.ya;
    s.u0 = b.u0 - du;
    s.u1 = b.u1 + du;
    return building_window_quad(wall, n, s, BUILDING_SILL_OUT);
}

/// Whether a wall's face `f` turns to the eye (the port's `vdot(nrm, vsub(cam.C, centre)) > 0`, which every part of a
/// wall is drawn behind).
inline bool building_wall_turned(TilePlace place, BuildingFace f) {
    float3 t = eye_relative(place, f.test);
    float toward = -(((f.normal.x * t.x) + (f.normal.y * t.y)) + (f.normal.z * t.z));
    return toward > 0.0f;
}

/// Whether wall `w`'s windows are drawn at the frame (its face `f` and its item's rank entry `rank`): its item drawn
/// nearer than win_d, not a church's with weather nearer than 520 m, its wall turned to the eye; a houseboat cabin's
/// with weather (the boat's), its item nearer than 520 m, its wall turned to the eye.
inline bool building_windows_drawn(uint theme_flags, TilePlace place, BuildingWindowWall w, BuildingFace f, uint rank) {
    if (rank == RANK_NONE) {
        return false;
    }
    uint detail = rank_detail(rank);
    bool weather = (theme_flags & THEME_WEATHER) != 0u;
    if (w.style == BUILDING_WINDOW_CABIN) {
        if (!weather || (detail & BUILDING_DETAIL_CHURCH) == 0u) {
            return false;
        }
        return building_wall_turned(place, f);
    }
    if ((detail & BUILDING_DETAIL_WINDOWS) == 0u) {
        return false;
    }
    if ((w.flags & BUILDING_WINDOW_CHURCH) != 0u && weather && (detail & BUILDING_DETAIL_CHURCH) != 0u) {
        return false;
    }
    return building_wall_turned(place, f);
}

/// How many windows of wall `w` the frame decides (its item's detail bits `detail`): all where its item is nearer than
/// win_d, a houseboat cabin's where it is nearer than 520 m.
inline uint building_window_count(BuildingWindowWall w, uint detail) {
    uint reach = w.style == BUILDING_WINDOW_CABIN ? BUILDING_DETAIL_CHURCH : BUILDING_DETAIL_WINDOWS;
    return (detail & reach) != 0u ? w.levels * w.cols : 0u;
}

/// How many window records the frame gives wall `w` (its item's rank entry `rank`): its windows
/// (building_window_count's), and its shop glazing's where it has one and its item is nearer than 760 m (the CPU's jobs
/// give as many; windows_cs writes each, drawn or not).
inline uint building_window_records(BuildingWindowWall w, uint rank) {
    if (rank == RANK_NONE) {
        return 0u;
    }
    uint detail = rank_detail(rank);
    uint n = building_window_count(w, detail);
    if ((w.flags & BUILDING_WINDOW_GLAZING) != 0u && (detail & BUILDING_DETAIL_FACADES) != 0u) {
        n = n + 1u;
    }
    return n;
}

/// Whether wall `w`'s flat detail is drawn at the frame: with weather, its item nearer than 760 m, its wall turned to
/// the eye.
inline bool building_facades_drawn(uint theme_flags, TilePlace place, BuildingFace f, uint rank) {
    return rank != RANK_NONE && (theme_flags & THEME_WEATHER) != 0u &&
           (rank_detail(rank) & BUILDING_DETAIL_FACADES) != 0u && building_wall_turned(place, f);
}

/// Whether a wall's windows are deep at the frame (its item's rank entry `rank`): with weather nearer than 160 m.
inline bool building_windows_deep(uint theme_flags, uint rank) {
    return rank != RANK_NONE && (theme_flags & THEME_WEATHER) != 0u &&
           (rank_detail(rank) & BUILDING_DETAIL_DEEP) != 0u;
}

/// Whether a wall's windows may have sash bars at the frame: its item nearer than 140 m.
inline bool building_windows_sashed(uint rank) {
    return rank != RANK_NONE && (rank_detail(rank) & BUILDING_DETAIL_SASH) != 0u;
}

/// The first row of wall `w`'s windows the frame draws: the shop floor's is left out with weather.
inline uint building_windows_first_row(uint theme_flags, BuildingWindowWall w) {
    bool weather = (theme_flags & THEME_WEATHER) != 0u;
    return (weather && (w.flags & BUILDING_WINDOW_SHOP_FLOOR) != 0u) ? 1u : 0u;
}

/// A window (or one of its parts) as the frame draws it: nothing (count 0), or its corners (CSS px, snapped at rest),
/// in the port's order, the span its outline's reciprocal depths keep within (its corners', widened as an edged
/// shape's), and its area (CSS px², of its corners before the snap, as the port measures Camera.poly's).
struct BuildingWindowShape {
    uint count;
    float2 p0;
    float2 p1;
    float2 p2;
    float2 p3;
    float2 p4;
    float lo;
    float hi;
    float area;
};

inline BuildingWindowShape building_window_nothing() {
    BuildingWindowShape s;
    float2 zero = {0.0f, 0.0f};
    s.count = 0u;
    s.p0 = zero;
    s.p1 = zero;
    s.p2 = zero;
    s.p3 = zero;
    s.p4 = zero;
    s.lo = 0.0f;
    s.hi = 0.0f;
    s.area = 0.0f;
    return s;
}

/// Corner i of a window's shape.
inline float2 building_window_corner(BuildingWindowShape s, uint i) {
    if (i == 0u) {
        return s.p0;
    }
    if (i == 1u) {
        return s.p1;
    }
    if (i == 2u) {
        return s.p2;
    }
    if (i == 3u) {
        return s.p3;
    }
    return s.p4;
}

/// Quad `win` (building_window_quad's) as Camera.poly gives it at the frame's camera with margin `margin` (CSS px): its
/// corners clipped at the near plane, nothing where fewer than three are left or their box lies beyond the frame and
/// the margin, with its area (unsnapped), snapped at rest.
inline BuildingWindowShape building_window_cut_in(FrameCamera cam, TilePlace place, BuildingPrim win, float margin) {
    BuildingWindowShape s = building_window_nothing();
    float near_z = cam.frame.w;
    float3 origin = {0.0f, 0.0f, 0.0f};
    float3 c[5] = {origin, origin, origin, origin, origin};
    uint m = 0u;
    for (uint i = 0u; i < 4u; ++i) {
        float3 a = camera_of(cam, eye_relative(place, building_prim_corner(win, i)));
        float3 b = camera_of(cam, eye_relative(place, building_prim_corner(win, (i + 1u) % 4u)));
        bool ai = a.z >= near_z;
        bool bi = b.z >= near_z;
        if (ai) {
            c[m] = a;
            m = m + 1u;
        }
        if (ai != bi) {
            float t = (near_z - a.z) / (b.z - a.z);
            float3 q = {a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, near_z};
            c[m] = q;
            m = m + 1u;
        }
    }
    if (m < 3u) {
        return s;
    }
    float2 zero = {0.0f, 0.0f};
    float2 q[5] = {zero, zero, zero, zero, zero};
    float min_x = 0.0f;
    float max_x = 0.0f;
    float min_y = 0.0f;
    float max_y = 0.0f;
    for (uint i = 0u; i < m; ++i) {
        q[i] = css_of(cam, c[i]);
        if (i == 0u) {
            min_x = q[i].x;
            max_x = q[i].x;
            min_y = q[i].y;
            max_y = q[i].y;
        } else {
            min_x = q[i].x < min_x ? q[i].x : min_x;
            max_x = q[i].x > max_x ? q[i].x : max_x;
            min_y = q[i].y < min_y ? q[i].y : min_y;
            max_y = q[i].y > max_y ? q[i].y : max_y;
        }
    }
    if (max_x < -margin || min_x > cam.frame.x + margin || max_y < -margin || min_y > cam.frame.y + margin) {
        return s;
    }
    float twice = 0.0f;
    for (uint i = 0u; i < m; ++i) {
        float2 a = q[i];
        float2 b = q[(i + 1u) % m];
        twice = twice + (a.x * b.y - b.x * a.y);
    }
    bool rest = camera_rests(cam);
    float lo = 0.0f;
    float hi = 0.0f;
    for (uint i = 0u; i < m; ++i) {
        float2 v = q[i];
        if (rest) {
            float2 snapped = {snap_tenth(v.x), snap_tenth(v.y)};
            v = snapped;
        }
        if (i == 0u) {
            s.p0 = v;
        } else if (i == 1u) {
            s.p1 = v;
        } else if (i == 2u) {
            s.p2 = v;
        } else if (i == 3u) {
            s.p3 = v;
        } else {
            s.p4 = v;
        }
        float recip = near_z / c[i].z;
        lo = i == 0u || recip < lo ? recip : lo;
        hi = i == 0u || recip > hi ? recip : hi;
    }
    s.count = m;
    s.lo = lo - lo * BUILDING_PLANE_SPAN;
    s.hi = hi + hi * BUILDING_PLANE_SPAN;
    s.area = abs(twice) / 2.0f;
    return s;
}

/// Quad `win` as Camera.poly gives it with the windows' margin of 300 px (building_window_cut_in's).
inline BuildingWindowShape building_window_cut(FrameCamera cam, TilePlace place, BuildingPrim win) {
    return building_window_cut_in(cam, place, win, BUILDING_MARGIN);
}

/// `s` where its area is over `least` (CSS px², the port's `area(sp) > least`), else nothing.
inline BuildingWindowShape building_window_over(BuildingWindowShape s, float least) {
    if (s.count == 0u || !(s.area > least)) {
        return building_window_nothing();
    }
    return s;
}

/// Pane c of houseboat cabin wall `w` (its wall's primitive `wall`, its face's normal `n`) as the frame draws it at its
/// camera: quad_at(a, b, y0 + 0.35, y0 + 1.0, (c + 0.22) / k, (c + 0.78) / k, 0.03, n) as Camera.poly gives it with a
/// margin of 200 px, its area (unsnapped) over 0.2 px², snapped at rest.
inline BuildingWindowShape building_cabin_window(FrameCamera cam, TilePlace place, BuildingPrim wall, float3 n,
                                                 BuildingWindowWall w, uint c) {
    float k = float(w.cols);
    BuildingWindowBox b;
    b.ya = wall.c0.y + BUILDING_CABIN_FROM;
    b.yb = wall.c0.y + BUILDING_CABIN_TO;
    b.u0 = (float(c) + BUILDING_CABIN_U0) / k;
    b.u1 = (float(c) + BUILDING_CABIN_U1) / k;
    BuildingWindowShape s =
        building_window_cut_in(cam, place, building_window_quad(wall, n, b, BUILDING_CABIN_OUT), BUILDING_CABIN_MARGIN);
    return building_window_over(s, BUILDING_CABIN_AREA);
}

/// The window `win` (building_window_prim's) as the frame draws it at its camera: Camera.poly's corners, its area
/// (unsnapped) over the windows' least, snapped at rest.
inline BuildingWindowShape building_window_shape(FrameCamera cam, TilePlace place, BuildingPrim win) {
    return building_window_over(building_window_cut(cam, place, win), BUILDING_WINDOW_MIN_AREA);
}

/// Wall `f`'s plane in camera coordinates (as building_shape's: its normal turned with the tile's place, through its
/// test point).
inline float4 building_window_plane(FrameCamera cam, TilePlace place, BuildingFace f) {
    float3 nrm = {f.normal.x / place.scale.x, f.normal.y, f.normal.z};
    float3 on_face = eye_relative(place, f.test);
    float3 nk = camera_of(cam, nrm);
    float4 plane = {nk.x, nk.y, nk.z, ((nrm.x * on_face.x) + (nrm.y * on_face.y)) + (nrm.z * on_face.z)};
    return plane;
}

/// The reciprocal depth of plane `plane` at CSS point `css` (building_plane_recip's, unclamped).
inline float building_window_plane_recip(FrameCamera cam, float4 plane, float2 css) {
    float3 ray = {(css.x - cam.right.w) / cam.forward.w, (cam.up.w - css.y) / cam.forward.w, 1.0f};
    float along = ((plane.x * ray.x) + (plane.y * ray.y)) + (plane.z * ray.z);
    return cam.frame.w * along / plane.w;
}

/// Shape `s` of a part off its wall's plane (a deep window's set-back glass, its reveal and sill, its sash bars) with
/// its span widened to hold its wall's plane's reciprocal depths at its corners: it draws on that plane, which its own
/// corners lie behind or before.
inline BuildingWindowShape building_window_on_plane(FrameCamera cam, float4 plane, BuildingWindowShape s) {
    if (s.count == 0u) {
        return s;
    }
    float lo = s.lo;
    float hi = s.hi;
    for (uint i = 0u; i < s.count; ++i) {
        float r = building_window_plane_recip(cam, plane, building_window_corner(s, i));
        float r_lo = r - r * BUILDING_PLANE_SPAN;
        float r_hi = r + r * BUILDING_PLANE_SPAN;
        lo = r_lo < lo ? r_lo : lo;
        hi = r_hi > hi ? r_hi : hi;
    }
    s.lo = lo;
    s.hi = hi;
    return s;
}

/// A window's shape as an edged building shape on its wall's plane (building_outline's and building_plane_recip's).
inline BuildingShape building_window_as_shape(BuildingWindowShape w, float4 plane, float lead) {
    BuildingShape s = building_nothing();
    s.count = w.count;
    s.p0 = w.p0;
    s.p1 = w.p1;
    s.p2 = w.p2;
    s.p3 = w.p3;
    s.p4 = w.p4;
    s.plane = plane;
    s.lo = w.lo;
    s.hi = w.hi;
    s.lead = lead;
    return s;
}

/// A window's sash bars as the port draws them: nothing, or the two segments m1 to m2 (its bottom's middle to its
/// top's) and h1 to h2 (across at 0.42 of its height), CSS px snapped at rest, with the span of their reciprocal
/// depths (widened as a shape's).
struct BuildingSash {
    bool drawn;
    float2 m1;
    float2 m2;
    float2 h1;
    float2 h2;
    float lo;
    float hi;
};

inline BuildingSash building_sash_nothing() {
    BuildingSash s;
    float2 zero = {0.0f, 0.0f};
    s.drawn = false;
    s.m1 = zero;
    s.m2 = zero;
    s.h1 = zero;
    s.h2 = zero;
    s.lo = 0.0f;
    s.hi = 0.0f;
    return s;
}

/// The sash bars of a window's quad `q4` (building_window_quad's at the glass's offset + 0.01): each point projected as
/// Camera.proj does (none behind the near plane: then no bars).
inline BuildingSash building_sash(FrameCamera cam, TilePlace place, BuildingPrim q4) {
    BuildingSash s = building_sash_nothing();
    float near_z = cam.frame.w;
    float3 bottom = (q4.c0 + q4.c1) / 2.0f;
    float3 top = (q4.c2 + q4.c3) / 2.0f;
    float3 left = q4.c0 + (q4.c3 - q4.c0) * BUILDING_SASH_CROSS;
    float3 right = q4.c1 + (q4.c2 - q4.c1) * BUILDING_SASH_CROSS;
    float3 k0 = camera_of(cam, eye_relative(place, bottom));
    float3 k1 = camera_of(cam, eye_relative(place, top));
    float3 k2 = camera_of(cam, eye_relative(place, left));
    float3 k3 = camera_of(cam, eye_relative(place, right));
    if (k0.z < near_z || k1.z < near_z || k2.z < near_z || k3.z < near_z) {
        return s;
    }
    bool rest = camera_rests(cam);
    float2 p[4] = {css_of(cam, k0), css_of(cam, k1), css_of(cam, k2), css_of(cam, k3)};
    float lo = 0.0f;
    float hi = 0.0f;
    float z[4] = {k0.z, k1.z, k2.z, k3.z};
    for (uint i = 0u; i < 4u; ++i) {
        if (rest) {
            float2 snapped = {snap_tenth(p[i].x), snap_tenth(p[i].y)};
            p[i] = snapped;
        }
        float recip = near_z / z[i];
        lo = i == 0u || recip < lo ? recip : lo;
        hi = i == 0u || recip > hi ? recip : hi;
    }
    s.drawn = true;
    s.m1 = p[0];
    s.m2 = p[1];
    s.h1 = p[2];
    s.h2 = p[3];
    s.lo = lo - lo * BUILDING_PLANE_SPAN;
    s.hi = hi + hi * BUILDING_PLANE_SPAN;
    return s;
}

/// Bar i (0: m1 to m2, 1: h1 to h2) of sash `s` stroked `half` CSS px either side, butt-capped: a quad (no area where
/// its ends meet), with the sash's span.
inline BuildingWindowShape building_sash_bar(BuildingSash s, uint i, float half) {
    BuildingWindowShape b = building_window_nothing();
    if (!s.drawn) {
        return b;
    }
    float2 a = i == 0u ? s.m1 : s.h1;
    float2 e = (i == 0u ? s.m2 : s.h2) - a;
    float len = sqrt(e.x * e.x + e.y * e.y);
    if (!(len > 0.0f)) {
        return b;
    }
    float2 n = {-e.y * half / len, e.x * half / len};
    b.count = 4u;
    b.p0 = a + n;
    b.p1 = a + e + n;
    b.p2 = a + e - n;
    b.p3 = a - n;
    b.p4 = b.p3;
    b.lo = s.lo;
    b.hi = s.hi;
    b.area = 2.0f * half * len;
    return b;
}

/// Sash `s` with its span widened to its wall's plane's at its points (building_window_on_plane's).
inline BuildingSash building_sash_on_plane(FrameCamera cam, float4 plane, BuildingSash s) {
    if (!s.drawn) {
        return s;
    }
    float2 p[4] = {s.m1, s.m2, s.h1, s.h2};
    for (uint i = 0u; i < 4u; ++i) {
        float r = building_window_plane_recip(cam, plane, p[i]);
        float r_lo = r - r * BUILDING_PLANE_SPAN;
        float r_hi = r + r * BUILDING_PLANE_SPAN;
        s.lo = r_lo < s.lo ? r_lo : s.lo;
        s.hi = r_hi > s.hi ? r_hi : s.hi;
    }
    return s;
}

/// Corner i of a window's shape as its glass turns there: its two edges' inward normals and 1 + n_a · n_b (0.25 or
/// less: a corner too sharp to erode).
struct BuildingGlassTurn {
    float2 n_in;
    float2 n_out;
    float k;
};

/// Corner i's turn, with the shoelace sum's sign `sign` (the shape's orientation).
inline BuildingGlassTurn building_glass_turn(BuildingWindowShape s, uint i, float sign) {
    uint n = s.count;
    float2 at = building_window_corner(s, i);
    float2 d_in = building_unit(at - building_window_corner(s, (i + n - 1u) % n));
    float2 d_out = building_unit(building_window_corner(s, (i + 1u) % n) - at);
    // the inward normals (building_outline's outward ones turned back)
    float2 a = {-sign * d_in.y, sign * d_in.x};
    float2 b = {-sign * d_out.y, sign * d_out.x};
    BuildingGlassTurn t;
    t.n_in = a;
    t.n_out = b;
    t.k = 1.0f + (a.x * b.x + a.y * b.y);
    return t;
}

/// The sign of a window shape's shoelace sum.
inline float building_window_sign(BuildingWindowShape s) {
    float twice = 0.0f;
    for (uint k = 0u; k < s.count; ++k) {
        float2 a = building_window_corner(s, k);
        float2 b = building_window_corner(s, (k + 1u) % s.count);
        twice = twice + (a.x * b.y - b.x * a.y);
    }
    return twice > 0.0f ? 1.0f : -1.0f;
}

/// Corner i of the glass a window's stroke of half width `r` (CSS px) leaves: the window's polygon eroded by r, each
/// corner moved in along its two edges' inward normals (r (n_a + n_b) / (1 + n_a · n_b)); a corner too sharp to erode
/// stays (building_glass_drawn draws no glass then).
inline float2 building_glass_corner(BuildingWindowShape s, uint i, float r) {
    BuildingGlassTurn t = building_glass_turn(s, i, building_window_sign(s));
    float2 at = building_window_corner(s, i);
    if (!(t.k > 0.25f)) {
        return at;
    }
    float2 moved = {at.x + r * (t.n_in.x + t.n_out.x) / t.k, at.y + r * (t.n_in.y + t.n_out.y) / t.k};
    return moved;
}

/// Whether the glass of `s` eroded by r is a polygon: its corners distinct, none too sharp, and each of its edges
/// keeping its edge's direction (a window no wider than the stroke somewhere, or one snapping squeezed, is its frame's
/// alone).
inline bool building_glass_drawn(BuildingWindowShape s, float r) {
    if (s.count < 3u) {
        return false;
    }
    float sign = building_window_sign(s);
    for (uint i = 0u; i < s.count; ++i) {
        uint j = (i + 1u) % s.count;
        float2 e = building_window_corner(s, j) - building_window_corner(s, i);
        if (e.x == 0.0f && e.y == 0.0f) {
            return false;
        }
        if (!(building_glass_turn(s, i, sign).k > 0.25f)) {
            return false;
        }
        float2 g = building_glass_corner(s, j, r) - building_glass_corner(s, i, r);
        if (!((e.x * g.x + e.y * g.y) > 0.0f)) {
            return false;
        }
    }
    return true;
}

/// Corner i of window `s`'s outline mitred out by r (CSS px): the glass's corner (building_glass_corner) mirrored about
/// the window's, r out along both its edges, which holds the round join's arc there. For a corner of a window with
/// glass (1 + n_a · n_b over 0.25) it lies within 2.9 r of the window's.
inline float2 building_frame_corner(BuildingWindowShape s, uint i, float r) {
    BuildingGlassTurn t = building_glass_turn(s, i, building_window_sign(s));
    float2 at = building_window_corner(s, i);
    float2 moved = {at.x - r * (t.n_in.x + t.n_out.x) / t.k, at.y - r * (t.n_in.y + t.n_out.y) / t.k};
    return moved;
}

/// Vertex v (0 to 29: 10 triangles) of a window's frame, a polygon holding the band its stroke of half width r paints,
/// whose fragments keep the samples the stroke covers (building_window_covers): with glass (`glass`, building_glass_drawn
/// as windows_cs decided it), the band between the window mitred out by r (building_frame_corner) and its glass, edge by
/// edge a quad (glass j, out j, out j + 1; glass j, out j + 1, glass j + 1), the triangles past a window's last
/// repeating its glass's last corner (no area); without, the window's box grown by r, two triangles. Its inner edges
/// are the glass's own, so the two fit without a crack.
inline float2 building_window_frame_point(BuildingWindowShape s, uint v, float r, bool glass) {
    uint t = v / 3u;
    uint k = v - t * 3u;
    if (!glass) {
        float2 lo = s.p0;
        float2 hi = s.p0;
        for (uint i = 1u; i < s.count; ++i) {
            float2 c = building_window_corner(s, i);
            lo.x = c.x < lo.x ? c.x : lo.x;
            lo.y = c.y < lo.y ? c.y : lo.y;
            hi.x = c.x > hi.x ? c.x : hi.x;
            hi.y = c.y > hi.y ? c.y : hi.y;
        }
        float2 a = {lo.x - r, lo.y - r};
        float2 c = {hi.x + r, hi.y + r};
        float2 b = {c.x, a.y};
        float2 d = {a.x, c.y};
        if (t >= 2u || k == 0u) {
            return a;
        }
        if (t == 0u) {
            return k == 1u ? b : c;
        }
        return k == 1u ? c : d;
    }
    uint m = s.count;
    uint j = t / 2u;
    if (j >= m) {
        return building_glass_corner(s, m - 1u, r);
    }
    uint next = (j + 1u) % m;
    if (k == 0u) {
        return building_glass_corner(s, j, r);
    }
    if ((t & 1u) == 0u) {
        return building_frame_corner(s, k == 1u ? j : next, r);
    }
    return k == 1u ? building_frame_corner(s, next, r) : building_glass_corner(s, next, r);
}

/// Whether a window's stroke of half width `r` with its fill under it covers CSS point `p`: the point lies within the
/// window `s` or within r of its outline (SVG's round-joined stroke of a closed path), the frame's and the twin's.
inline bool building_window_covers(BuildingWindowShape s, float2 p, float r) {
    float nearest = -1.0f;
    float sign = building_window_sign(s);
    bool inside = s.count >= 3u;
    for (uint i = 0u; i < s.count; ++i) {
        float2 a = building_window_corner(s, i);
        float2 b = building_window_corner(s, (i + 1u) % s.count);
        float2 e = b - a;
        float2 d = p - a;
        float ee = e.x * e.x + e.y * e.y;
        float t = ee > 0.0f ? (d.x * e.x + d.y * e.y) / ee : 0.0f;
        t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
        float2 g = d - e * t;
        float dd = g.x * g.x + g.y * g.y;
        nearest = nearest < 0.0f || dd < nearest ? dd : nearest;
        // inside: left of every edge for a positive sum, right for a negative one
        if (sign * (e.x * d.y - e.y * d.x) < 0.0f) {
            inside = false;
        }
    }
    return inside || (nearest >= 0.0f && nearest <= r * r);
}

/// A colour 0xRRGGBB as the shaders take it: sRGB 0 to 1 at 8-bit levels.
inline float3 building_rgb(uint c) {
    float3 v = {float((c >> 16u) & 0xFFu), float((c >> 8u) & 0xFFu), float(c & 0xFFu)};
    return v / 255.0f;
}

/// A window's glass at the frame: a flat colour (top = bottom) or the gradient from its path's box's top to its
/// bottom (the port's url(#glass) and url(#glassLit)).
struct BuildingGlass {
    float3 top;
    float3 bottom;
    bool gradient;
};

/// The glass of a window, lit or not, of a wall with flags `flags` and style `style`, at the moment (amsterdam.py:
/// gd, gl = (url(#glass), url(#glassLit)) by day with weather, else (dark by day or at night, lit); a warehouse's
/// shutters with weather; a Paris stone front's lit panes as its dark ones by day; a houseboat cabin's own at night).
inline BuildingGlass building_glass(FrameWindows w, uint theme_flags, uint style, uint flags, bool lit) {
    bool weather = (theme_flags & THEME_WEATHER) != 0u;
    bool night = (theme_flags & THEME_NIGHT) != 0u;
    bool overcast = (theme_flags & THEME_OVERCAST) != 0u;
    BuildingGlass dark;
    BuildingGlass bright;
    if (weather && !night) {
        dark.top = building_rgb(overcast ? w.glass.z : w.glass.x);
        dark.bottom = building_rgb(overcast ? w.glass.w : w.glass.y);
        dark.gradient = true;
        bright.top = building_rgb(w.lit.x);
        bright.bottom = building_rgb(w.lit.y);
        bright.gradient = true;
    } else {
        dark.top = building_rgb(night ? w.dark.y : w.dark.x);
        dark.bottom = dark.top;
        dark.gradient = false;
        bright.top = building_rgb(w.lit.z);
        bright.bottom = bright.top;
        bright.gradient = false;
    }
    if ((flags & BUILDING_WINDOW_WAREHOUSE) != 0u && weather) {
        dark.top = building_rgb(night ? w.dark.w : w.dark.z);
        dark.bottom = dark.top;
        dark.gradient = false;
        bright = dark;
    }
    if (style == BUILDING_WINDOW_PARIS && !night) {
        bright = dark;
    }
    if (style == BUILDING_WINDOW_CABIN && night) {
        dark.top = building_rgb(w.cabin.z);
        dark.bottom = dark.top;
        dark.gradient = false;
    }
    if (lit) {
        return bright;
    }
    return dark;
}

/// The windows' frames' colour at the moment (their sash bars' too).
inline float3 building_window_frame(FrameWindows w, uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? w.frame.y : w.frame.x);
}

/// A houseboat cabin's windows' frames' colour at the moment, and their width (CSS px).
inline float3 building_cabin_frame(FrameWindows w, uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? w.cabin.y : w.cabin.x);
}

inline float building_cabin_frame_width(FrameWindows w) {
    return asfloat(w.cabin.w);
}

/// The deep windows' sills' colour at the moment.
inline float3 building_window_sill_colour(FrameWindows w, uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? w.frame.w : w.frame.z);
}

/// A shop's glazing's frame's colour at the moment, and its width (CSS px).
inline float3 building_shop_frame(FrameWindows w, uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? w.shop.y : w.shop.x);
}

inline float building_shop_frame_width(FrameWindows w) {
    return asfloat(w.shop.z);
}

/// The plinths' colour at the moment, and the cornices'.
inline float3 building_plinth_colour(FrameWindows w, uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? w.facades.y : w.facades.x);
}

inline float3 building_cornice_colour(FrameWindows w, uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? w.facades.w : w.facades.z);
}

/// The windows' frames' width (CSS px), but where they are deep (the wall record's).
inline float building_window_frame_width(FrameWindows w) {
    return asfloat(w.lit.w);
}

/// A width in tenths of a CSS px (passes::window_widths', as the port prints it), as the frame draws it.
inline float building_tenths(uint tenths) {
    return float(tenths) / 10.0f;
}

// A window's record, which windows_cs writes for each window of the frame's jobs and the windows' vertex stages read
// (4 uint4): v0 its header (corners, bits 0-2; lit, bit 3; its wall's warehouse flag, bit 4; its style, bits 5-6; its
// glass drawn, bit 7: building_glass_drawn at its frame's half width; a shop's glazing, bit 8: its frame the shops'
// colour and width, its glass's gradient over its own box), its wall's record among the frame's walls, its painter
// slot, its span's low end; v1 its span's high end and its first three corners' x, y (CSS px) but the last; then the
// rest of its five corners. A header 0: the window is not drawn.
static const uint BUILDING_WINDOW_RECORD_VECTORS = 4u;
static const uint BUILDING_WINDOW_LIT = 8u;
static const uint BUILDING_WINDOW_RECORD_WAREHOUSE = 16u;
static const uint BUILDING_WINDOW_RECORD_STYLE_SHIFT = 5u;
static const uint BUILDING_WINDOW_RECORD_GLASS = 128u;
static const uint BUILDING_WINDOW_RECORD_SHOP = 256u;

struct BuildingWindowRecord {
    uint4 v0;
    uint4 v1;
    uint4 v2;
    uint4 v3;
};

/// The record of window shape `s` (lit or not, with glass or not, a shop's glazing or not) of wall `w`, the frame's
/// wall record `wall`, at painter slot `slot`.
inline BuildingWindowRecord building_window_record(BuildingWindowShape s, bool lit, bool glass, bool shop,
                                                   BuildingWindowWall w, uint wall, uint slot) {
    BuildingWindowRecord r;
    uint header = 0u;
    if (s.count != 0u) {
        header = s.count | (lit ? BUILDING_WINDOW_LIT : 0u) |
                 ((w.flags & BUILDING_WINDOW_WAREHOUSE) != 0u && !shop ? BUILDING_WINDOW_RECORD_WAREHOUSE : 0u) |
                 ((shop ? BUILDING_WINDOW_PLAIN : w.style) << BUILDING_WINDOW_RECORD_STYLE_SHIFT) |
                 (glass ? BUILDING_WINDOW_RECORD_GLASS : 0u) | (shop ? BUILDING_WINDOW_RECORD_SHOP : 0u);
    }
    uint4 v0 = {header, wall, slot, asuint(s.lo)};
    uint4 v1 = {asuint(s.hi), asuint(s.p0.x), asuint(s.p0.y), asuint(s.p1.x)};
    uint4 v2 = {asuint(s.p1.y), asuint(s.p2.x), asuint(s.p2.y), asuint(s.p3.x)};
    uint4 v3 = {asuint(s.p3.y), asuint(s.p4.x), asuint(s.p4.y), 0u};
    r.v0 = v0;
    r.v1 = v1;
    r.v2 = v2;
    r.v3 = v3;
    return r;
}

/// A record's shape.
inline BuildingWindowShape building_window_of(BuildingWindowRecord r) {
    BuildingWindowShape s = building_window_nothing();
    s.count = r.v0.x & 7u;
    s.lo = asfloat(r.v0.w);
    s.hi = asfloat(r.v1.x);
    float2 p0 = {asfloat(r.v1.y), asfloat(r.v1.z)};
    float2 p1 = {asfloat(r.v1.w), asfloat(r.v2.x)};
    float2 p2 = {asfloat(r.v2.y), asfloat(r.v2.z)};
    float2 p3 = {asfloat(r.v2.w), asfloat(r.v3.x)};
    float2 p4 = {asfloat(r.v3.y), asfloat(r.v3.z)};
    s.p0 = p0;
    s.p1 = p1;
    s.p2 = p2;
    s.p3 = p3;
    s.p4 = p4;
    return s;
}

// A near window's record (a window of a wall whose item is nearer than 160 m), which windows_cs writes beside its
// window's and window_near_vs reads (10 uint4): v0 its header (its reveal's corners, bits 0-2; its sill's, 3-5; its sash
// bars, bit 6), its wall's record among the frame's walls, its wall's first painter slot (its reveals'); then its
// reveal (its span's ends, its five corners), its sill alike, and its sash bars (their span's ends, m1, m2, h1, h2). A
// header 0: nothing of it is drawn.
static const uint BUILDING_NEAR_RECORD_VECTORS = 10u;
static const uint BUILDING_NEAR_SILL_SHIFT = 3u;
static const uint BUILDING_NEAR_SASH = 64u;

struct BuildingNearRecord {
    uint4 v0;
    uint4 v1;
    uint4 v2;
    uint4 v3;
    uint4 v4;
    uint4 v5;
    uint4 v6;
    uint4 v7;
    uint4 v8;
    uint4 v9;
};

/// The record of a near window's reveal `reveal`, sill `sill` and sash bars `sash`, the frame's wall record `wall`, its
/// wall's first slot `slot`.
inline BuildingNearRecord building_near_record(BuildingWindowShape reveal, BuildingWindowShape sill, BuildingSash sash,
                                               uint wall, uint slot) {
    BuildingNearRecord r;
    uint header = reveal.count | (sill.count << BUILDING_NEAR_SILL_SHIFT) | (sash.drawn ? BUILDING_NEAR_SASH : 0u);
    uint4 v0 = {header, wall, slot, 0u};
    uint4 v1 = {asuint(reveal.lo), asuint(reveal.hi), asuint(reveal.p0.x), asuint(reveal.p0.y)};
    uint4 v2 = {asuint(reveal.p1.x), asuint(reveal.p1.y), asuint(reveal.p2.x), asuint(reveal.p2.y)};
    uint4 v3 = {asuint(reveal.p3.x), asuint(reveal.p3.y), asuint(reveal.p4.x), asuint(reveal.p4.y)};
    uint4 v4 = {asuint(sill.lo), asuint(sill.hi), asuint(sill.p0.x), asuint(sill.p0.y)};
    uint4 v5 = {asuint(sill.p1.x), asuint(sill.p1.y), asuint(sill.p2.x), asuint(sill.p2.y)};
    uint4 v6 = {asuint(sill.p3.x), asuint(sill.p3.y), asuint(sill.p4.x), asuint(sill.p4.y)};
    uint4 v7 = {asuint(sash.lo), asuint(sash.hi), asuint(sash.m1.x), asuint(sash.m1.y)};
    uint4 v8 = {asuint(sash.m2.x), asuint(sash.m2.y), asuint(sash.h1.x), asuint(sash.h1.y)};
    uint4 v9 = {asuint(sash.h2.x), asuint(sash.h2.y), 0u, 0u};
    r.v0 = v0;
    r.v1 = v1;
    r.v2 = v2;
    r.v3 = v3;
    r.v4 = v4;
    r.v5 = v5;
    r.v6 = v6;
    r.v7 = v7;
    r.v8 = v8;
    r.v9 = v9;
    return r;
}

/// A near record's shape from its vectors a, b, c (the reveal's or the sill's) with `count` corners.
inline BuildingWindowShape building_near_shape(uint count, uint4 a, uint4 b, uint4 c) {
    BuildingWindowShape s = building_window_nothing();
    s.count = count;
    s.lo = asfloat(a.x);
    s.hi = asfloat(a.y);
    float2 p0 = {asfloat(a.z), asfloat(a.w)};
    float2 p1 = {asfloat(b.x), asfloat(b.y)};
    float2 p2 = {asfloat(b.z), asfloat(b.w)};
    float2 p3 = {asfloat(c.x), asfloat(c.y)};
    float2 p4 = {asfloat(c.z), asfloat(c.w)};
    s.p0 = p0;
    s.p1 = p1;
    s.p2 = p2;
    s.p3 = p3;
    s.p4 = p4;
    return s;
}

inline BuildingWindowShape building_near_reveal(BuildingNearRecord r) {
    return building_near_shape(r.v0.x & 7u, r.v1, r.v2, r.v3);
}

inline BuildingWindowShape building_near_sill(BuildingNearRecord r) {
    return building_near_shape((r.v0.x >> BUILDING_NEAR_SILL_SHIFT) & 7u, r.v4, r.v5, r.v6);
}

inline BuildingSash building_near_sash(BuildingNearRecord r) {
    BuildingSash s = building_sash_nothing();
    s.drawn = (r.v0.x & BUILDING_NEAR_SASH) != 0u;
    s.lo = asfloat(r.v7.x);
    s.hi = asfloat(r.v7.y);
    float2 m1 = {asfloat(r.v7.z), asfloat(r.v7.w)};
    float2 m2 = {asfloat(r.v8.x), asfloat(r.v8.y)};
    float2 h1 = {asfloat(r.v8.z), asfloat(r.v8.w)};
    float2 h2 = {asfloat(r.v9.x), asfloat(r.v9.y)};
    s.m1 = m1;
    s.m2 = m2;
    s.h1 = h1;
    s.h2 = h2;
    return s;
}

/// Which part vertex v (0 to 29) of a near window draws: 0 its reveal (v 0 to 8, a fan of 3 triangles), 1 its sill (9
/// to 17), 2 its sash bars (18 to 29: two quads, each two triangles).
inline uint building_near_part(uint v) {
    return v < 9u ? 0u : (v < 18u ? 1u : 2u);
}

/// Point v of a near window's part (building_near_part's): the fan's corner (0, t + 1, t + 2) of its triangle t, the
/// points past its last repeating it; a bar's corner (0, 1, 2), (0, 2, 3).
inline float2 building_near_point(BuildingNearRecord r, uint v, float sash_half) {
    uint part = building_near_part(v);
    if (part == 2u) {
        uint i = v - 18u;
        uint bar = i / 6u;
        uint k = i - bar * 6u;
        uint corner = k == 0u || k == 3u ? 0u : (k == 1u ? 1u : (k == 2u || k == 4u ? 2u : 3u));
        return building_window_corner(building_sash_bar(building_near_sash(r), bar, sash_half), corner);
    }
    BuildingWindowShape s = building_near_reveal(r);
    if (part == 1u) {
        s = building_near_sill(r);
    }
    uint i = v - part * 9u;
    uint t = i / 3u;
    uint k = i - t * 3u;
    uint corner = k == 0u ? 0u : t + k;
    return building_window_corner(s, corner < s.count ? corner : s.count - 1u);
}

/// The shape vertex v of a near window draws on (its reveal, its sill, or its bar), for its depth.
inline BuildingWindowShape building_near_shape_of(BuildingNearRecord r, uint v, float sash_half) {
    uint part = building_near_part(v);
    if (part == 2u) {
        return building_sash_bar(building_near_sash(r), (v - 18u) / 6u, sash_half);
    }
    if (part == 1u) {
        return building_near_sill(r);
    }
    return building_near_reveal(r);
}

// A facade's record (a facade wall of the frame's jobs with a plinth or a cornice whose item is nearer than 760 m),
// which windows_cs writes and window_facade_vs reads (7 uint4): v0 its header (its plinth's corners, bits 0-2; its
// cornice's, 3-5), its wall's record among the frame's walls, its building's plinth's painter slot (its cornice's the
// next); then its plinth (its span's ends, its five corners) and its cornice alike. A header 0: neither is drawn.
static const uint BUILDING_FACADE_RECORD_VECTORS = 7u;

struct BuildingFacadeRecord {
    uint4 v0;
    uint4 v1;
    uint4 v2;
    uint4 v3;
    uint4 v4;
    uint4 v5;
    uint4 v6;
};

/// The record of a facade's plinth `plinth` and cornice `cornice`, the frame's wall record `wall`, its building's
/// plinth's slot `slot`.
inline BuildingFacadeRecord building_facade_record(BuildingWindowShape plinth, BuildingWindowShape cornice, uint wall,
                                                   uint slot) {
    BuildingFacadeRecord r;
    uint4 v0 = {plinth.count | (cornice.count << 3u), wall, slot, 0u};
    uint4 v1 = {asuint(plinth.lo), asuint(plinth.hi), asuint(plinth.p0.x), asuint(plinth.p0.y)};
    uint4 v2 = {asuint(plinth.p1.x), asuint(plinth.p1.y), asuint(plinth.p2.x), asuint(plinth.p2.y)};
    uint4 v3 = {asuint(plinth.p3.x), asuint(plinth.p3.y), asuint(plinth.p4.x), asuint(plinth.p4.y)};
    uint4 v4 = {asuint(cornice.lo), asuint(cornice.hi), asuint(cornice.p0.x), asuint(cornice.p0.y)};
    uint4 v5 = {asuint(cornice.p1.x), asuint(cornice.p1.y), asuint(cornice.p2.x), asuint(cornice.p2.y)};
    uint4 v6 = {asuint(cornice.p3.x), asuint(cornice.p3.y), asuint(cornice.p4.x), asuint(cornice.p4.y)};
    r.v0 = v0;
    r.v1 = v1;
    r.v2 = v2;
    r.v3 = v3;
    r.v4 = v4;
    r.v5 = v5;
    r.v6 = v6;
    return r;
}

/// A facade record's plinth (part 0) or cornice (part 1).
inline BuildingWindowShape building_facade_part(BuildingFacadeRecord r, uint part) {
    if (part == 0u) {
        return building_near_shape(r.v0.x & 7u, r.v1, r.v2, r.v3);
    }
    return building_near_shape((r.v0.x >> 3u) & 7u, r.v4, r.v5, r.v6);
}

/// Point v (0 to 17: the plinth's fan of 3 triangles, then the cornice's) of a facade record: the fan's corner (0, t +
/// 1, t + 2) of its triangle t, the points past its last repeating it.
inline float2 building_facade_point(BuildingFacadeRecord r, uint v) {
    uint part = v < 9u ? 0u : 1u;
    BuildingWindowShape s = building_facade_part(r, part);
    uint i = v - part * 9u;
    uint t = i / 3u;
    uint k = i - t * 3u;
    uint corner = k == 0u ? 0u : t + k;
    return building_window_corner(s, corner < s.count ? corner : s.count - 1u);
}

// A windowed wall's record for the frame, which windows_cs writes once a windowed wall of the frame's jobs (3 uint4):
// its plane in camera coordinates; the box of its dark windows' corners from top (y0) to bottom (y1), then its lit
// ones' (CSS px; top below bottom where it has none; a church's windows' glass's as its dark ones' where it draws
// them); its frames' half width and its sash bars' (CSS px), its reveals' colour (0xBBGGRR, the wall's colour times
// 0.55 unlit at the moment), and its church windows' leading's width (CSS px).
static const uint BUILDING_WALL_RECORD_VECTORS = 3u;

struct BuildingWallRecord {
    float4 plane;
    float2 dark;
    float2 lit;
    float frame_half;
    float sash_half;
    uint reveal;
    float leading;
};

inline BuildingWallRecord building_wall_record_of(uint4 a, uint4 b, uint4 c) {
    BuildingWallRecord w;
    float4 plane = {asfloat(a.x), asfloat(a.y), asfloat(a.z), asfloat(a.w)};
    float2 dark = {asfloat(b.x), asfloat(b.y)};
    float2 lit = {asfloat(b.z), asfloat(b.w)};
    w.plane = plane;
    w.dark = dark;
    w.lit = lit;
    w.frame_half = asfloat(c.x);
    w.sash_half = asfloat(c.y);
    w.reveal = c.z;
    w.leading = asfloat(c.w);
    return w;
}

/// A colour 0xBBGGRR (the CPU's light's words) as the shaders take it.
inline float3 building_bgr(uint c) {
    float3 v = {float(c & 0xFFu), float((c >> 8u) & 0xFFu), float((c >> 16u) & 0xFFu)};
    return v / 255.0f;
}

/// The glass's colour at CSS height `y` over a path's box from `top` to `bottom` (objectBoundingBox from 0 to 1,
/// padded): its top's above the box, its bottom's below.
inline float3 building_glass_at(BuildingGlass g, float top, float bottom, float y) {
    if (!g.gradient || !(bottom > top)) {
        return g.top;
    }
    float t = (y - top) / (bottom - top);
    t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
    return g.top + (g.bottom - g.top) * t;
}

// A church's own windows (render/closeup.py's church_windows; CP/geometry/ChurchWindows.hpp, by which the tile's build
// counts each wall's): a church (building=church, its parts too) draws with weather nearer than 520 m, on each wall
// turned to the eye at least 6 m tall and 3 m long, tall round-arched windows instead of its rows of plain ones, one a
// bay of about six metres. The CPU counts them in binary64 as the port does (nb = max(1, int(elen / 6.2)), and each
// one's transoms: y = ys + 1.5 while y < ye) and the frame's jobs carry the counts (WINDOW_JOB_CHURCHES); the frame
// works out the rest in float from the wall's one-cell primitive (building_church_bay):
//   bw = elen / nb, wh = min(1.1, bw · 0.2) (half the window's width), ys = y0 + min(3.2, hgt · 0.22) (its sill), ye =
//   top − min(2.4, hgt · 0.14) − wh (the spring of its arch); window k at uc = (k + 0.5) · bw along the wall.
// Each window is three arches of one form, its foot's two corners, then its half circle from the right through the top
// to the left (nine points at angles π j / 8): its stone, grown 0.22 m (its foot that much lower), and its reveal on
// the wall's plane, its glass 0.38 m into the wall; and its leading, 0.37 m into the wall: a mullion from its sill to
// its arch's top, then a transom across it at each of its heights. Per frame each window is decided once (windows_cs;
// the twin alike), as the port decides it: each arch as Camera.poly gives it with a margin of 200 px (building_arch_cut,
// Camera.poly's for its eleven corners), the window left out where its stone is not there or covers under 4 px², its
// reveal where it is there, its glass where it is there, its leading where its glass covers over 60 px², each segment
// projected as Camera.proj does (none behind the near plane); a wall without any window's glass draws none of them (`if
// not glass: return []`).
//
// The port paints a wall's church windows as five paths at its windows' slots: their stones (#DCD6CA, by night
// #2A2E3A), their reveals (the wall's colour times 0.55, unlit: the plain windows' reveals'), their glass (the gradient
// `glass` over the path's box from top to bottom; by night #121622), by day their glass again in #2A3038 at opacity
// .42, and their leading (#262A30, by night #05060A, stroke-width max(0.4, 0.05 · focal / max(d, 1)) as '%.2f' prints
// it, butt-capped). The frame draws each part opaque on its wall's plane with a lead of its own over the wall's cells
// in the paths' order (the reveals', the glass's, the frames' and the sash bars' leads), its slot the path's under the
// painter switch; the glass with the day's veil folded in (its gradient's two stops each mixed with #2A3038 at .42, the
// veil over the gradient at every point): church_window_vs draws a record's arches as fans of 10 triangles and its
// leading as butt-capped bars.
static const uint BUILDING_ARCH_POINTS = 11u;
static const uint BUILDING_ARCH_MOST = 12u; // after the near plane's cut
static const float BUILDING_ARCH_COS[9] = {1.0f,          0.923879504f,  0.707106769f,  0.382683426f, 6.12323426e-17f,
                                           -0.382683426f, -0.707106769f, -0.923879504f, -1.0f};
static const float BUILDING_ARCH_SIN[9] = {0.0f,         0.382683426f, 0.707106769f, 0.923879504f,   1.0f,
                                           0.923879504f, 0.707106769f, 0.382683426f, 1.22464685e-16f};
// The port's constants: the windows' half width at most and its share of the bay, the sill's height at most and its
// share of the wall's, the arch's head room alike (m); the stone's growth, the glass's and the leading's depths into
// the wall, the transoms' step (m); Camera.poly's margin (CSS px), the stone's least area (inclusive) and the glass's
// for its leading (exclusive, CSS px²); the leading's least width (CSS px) and its share of focal / d; the veil's
// opacity.
static const float BUILDING_CHURCH_HALF = 1.1f;
static const float BUILDING_CHURCH_HALF_SHARE = 0.2f;
static const float BUILDING_CHURCH_SILL = 3.2f;
static const float BUILDING_CHURCH_SILL_SHARE = 0.22f;
static const float BUILDING_CHURCH_HEAD = 2.4f;
static const float BUILDING_CHURCH_HEAD_SHARE = 0.14f;
static const float BUILDING_CHURCH_STONE = 0.22f;
static const float BUILDING_CHURCH_GLASS = -0.38f;
static const float BUILDING_CHURCH_LEADING = -0.37f;
static const float BUILDING_CHURCH_TRANSOM = 1.5f;
static const float BUILDING_CHURCH_MARGIN = 200.0f;
static const float BUILDING_CHURCH_STONE_AREA = 4.0f;
static const float BUILDING_CHURCH_LEADING_AREA = 60.0f;
static const float BUILDING_CHURCH_VEIL = 0.42f;
// Their colours, 0xRRGGBB: the stone's by day and by night, the glass's by night, the veil's, the leading's by day and
// by night.
static const uint BUILDING_CHURCH_STONE_DAY = 0xDCD6CAu;
static const uint BUILDING_CHURCH_STONE_NIGHT = 0x2A2E3Au;
static const uint BUILDING_CHURCH_GLASS_NIGHT = 0x121622u;
static const uint BUILDING_CHURCH_VEIL_RGB = 0x2A3038u;
static const uint BUILDING_CHURCH_LEADING_DAY = 0x262A30u;
static const uint BUILDING_CHURCH_LEADING_NIGHT = 0x05060Au;
// The vertices a church window's record draws: its stone's, reveal's and glass's fans (10 triangles each), then its
// leading's bars, two triangles a segment (its mullion, then its transoms).
static const uint BUILDING_ARCH_VERTICES = 30u;
static const uint BUILDING_CHURCH_ARCH_VERTICES = 90u;
static const uint BUILDING_CHURCH_SEGMENT_VERTICES = 6u;

/// Whether wall `w`'s church windows are drawn at the frame (its face `f`, its item's rank entry `rank`): a church's,
/// with weather, its item nearer than 520 m, its wall turned to the eye (where it has any: the CPU's count).
inline bool building_church_drawn(uint theme_flags, TilePlace place, BuildingWindowWall w, BuildingFace f, uint rank) {
    if (rank == RANK_NONE || (w.flags & BUILDING_WINDOW_CHURCH) == 0u || (theme_flags & THEME_WEATHER) == 0u) {
        return false;
    }
    if ((rank_detail(rank) & BUILDING_DETAIL_CHURCH) == 0u) {
        return false;
    }
    return building_wall_turned(place, f);
}

/// A church wall's windows' layout (closeup.py's): its bays' width, half a window's width, its windows' sill and the
/// spring of their arches (frame metres), and the wall's unit direction from its first corner.
struct BuildingChurchBay {
    float bw;
    float wh;
    float ys;
    float ye;
    float ux;
    float uz;
};

/// The layout of `bays` windows on church wall `wall` (its one-cell primitive: corners (a, y0), (b, y0), (b, top), (a,
/// top)), in float.
inline BuildingChurchBay building_church_bay(BuildingPrim wall, uint bays) {
    float ex = wall.c1.x - wall.c0.x;
    float ez = wall.c1.z - wall.c0.z;
    float elen = sqrt(ex * ex + ez * ez);
    float y0 = wall.c0.y;
    float top = wall.c3.y;
    float hgt = top - y0;
    BuildingChurchBay b;
    b.bw = elen / float(bays > 1u ? bays : 1u);
    float half = b.bw * BUILDING_CHURCH_HALF_SHARE;
    b.wh = half < BUILDING_CHURCH_HALF ? half : BUILDING_CHURCH_HALF;
    float sill = hgt * BUILDING_CHURCH_SILL_SHARE;
    b.ys = y0 + (sill < BUILDING_CHURCH_SILL ? sill : BUILDING_CHURCH_SILL);
    float head = hgt * BUILDING_CHURCH_HEAD_SHARE;
    b.ye = (top - (head < BUILDING_CHURCH_HEAD ? head : BUILDING_CHURCH_HEAD)) - b.wh;
    b.ux = elen > 0.0f ? ex / elen : 0.0f;
    b.uz = elen > 0.0f ? ez / elen : 0.0f;
    return b;
}

/// The tile-local point `u` metres along church wall `wall` at height `y`, `off` metres out along its face's normal
/// `n` (closeup.py's W).
inline float3 building_church_point(BuildingPrim wall, float3 n, BuildingChurchBay b, float u, float y, float off) {
    float3 p = {(wall.c0.x + b.ux * u) + n.x * off, y, (wall.c0.z + b.uz * u) + n.z * off};
    return p;
}

/// Corner i (0 to 10) of window k's arch `off` metres out from its wall, grown `grow` metres (closeup.py's shape): its
/// foot's left and right corners, then its half circle from the right through the top to the left.
inline float3 building_arch_point(BuildingPrim wall, float3 n, BuildingChurchBay b, uint k, uint i, float off,
                                  float grow) {
    float uc = (float(k) + 0.5f) * b.bw;
    float w = b.wh + grow;
    if (i == 0u) {
        return building_church_point(wall, n, b, uc - w, b.ys - grow, off);
    }
    if (i == 1u) {
        return building_church_point(wall, n, b, uc + w, b.ys - grow, off);
    }
    uint j = i - 2u;
    return building_church_point(wall, n, b, uc + w * BUILDING_ARCH_COS[j], b.ye + w * BUILDING_ARCH_SIN[j], off);
}

/// A church window's arch as the frame draws it: nothing (count 0), or its corners (CSS px, snapped at rest) in the
/// port's order, the span its reciprocal depths keep within (its corners', widened as an edged shape's and to its
/// wall's plane's at them), and its area (CSS px², of its corners before the snap).
struct BuildingArch {
    uint count;
    float2 p[12];
    float lo;
    float hi;
    float area;
};

inline BuildingArch building_arch_nothing() {
    BuildingArch a;
    float2 zero = {0.0f, 0.0f};
    a.count = 0u;
    for (uint i = 0u; i < BUILDING_ARCH_MOST; ++i) {
        a.p[i] = zero;
    }
    a.lo = 0.0f;
    a.hi = 0.0f;
    a.area = 0.0f;
    return a;
}

/// Window k's arch `off` metres out from its wall and grown `grow` metres as Camera.poly gives it with a margin of 200
/// px at the frame's camera: its corners clipped at the near plane, nothing where fewer than three are left or their
/// box lies beyond the frame and the margin, with its area (unsnapped), snapped at rest, its span widened to its wall's
/// plane `plane` (it draws on that plane, which the glass lies behind).
inline BuildingArch building_arch_cut(FrameCamera cam, TilePlace place, BuildingPrim wall, float3 n, float4 plane,
                                      BuildingChurchBay b, uint k, float off, float grow) {
    BuildingArch s = building_arch_nothing();
    float near_z = cam.frame.w;
    float3 origin = {0.0f, 0.0f, 0.0f};
    float3 c[12] = {origin, origin, origin, origin, origin, origin, origin, origin, origin, origin, origin, origin};
    uint m = 0u;
    float3 first = camera_of(cam, eye_relative(place, building_arch_point(wall, n, b, k, 0u, off, grow)));
    float3 a = first;
    for (uint i = 0u; i < BUILDING_ARCH_POINTS; ++i) {
        float3 e = first;
        if (i + 1u < BUILDING_ARCH_POINTS) {
            e = camera_of(cam, eye_relative(place, building_arch_point(wall, n, b, k, i + 1u, off, grow)));
        }
        bool ai = a.z >= near_z;
        bool ei = e.z >= near_z;
        if (ai && m < BUILDING_ARCH_MOST) {
            c[m] = a;
            m = m + 1u;
        }
        if (ai != ei && m < BUILDING_ARCH_MOST) {
            float t = (near_z - a.z) / (e.z - a.z);
            float3 q = {a.x + (e.x - a.x) * t, a.y + (e.y - a.y) * t, near_z};
            c[m] = q;
            m = m + 1u;
        }
        a = e;
    }
    if (m < 3u) {
        return s;
    }
    float2 zero = {0.0f, 0.0f};
    float2 q[12] = {zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero};
    float min_x = 0.0f;
    float max_x = 0.0f;
    float min_y = 0.0f;
    float max_y = 0.0f;
    for (uint i = 0u; i < m; ++i) {
        q[i] = css_of(cam, c[i]);
        if (i == 0u) {
            min_x = q[i].x;
            max_x = q[i].x;
            min_y = q[i].y;
            max_y = q[i].y;
        } else {
            min_x = q[i].x < min_x ? q[i].x : min_x;
            max_x = q[i].x > max_x ? q[i].x : max_x;
            min_y = q[i].y < min_y ? q[i].y : min_y;
            max_y = q[i].y > max_y ? q[i].y : max_y;
        }
    }
    float margin = BUILDING_CHURCH_MARGIN;
    if (max_x < -margin || min_x > cam.frame.x + margin || max_y < -margin || min_y > cam.frame.y + margin) {
        return s;
    }
    float twice = 0.0f;
    for (uint i = 0u; i < m; ++i) {
        float2 u = q[i];
        float2 v = q[(i + 1u) % m];
        twice = twice + (u.x * v.y - v.x * u.y);
    }
    bool rest = camera_rests(cam);
    float lo = 0.0f;
    float hi = 0.0f;
    for (uint i = 0u; i < m; ++i) {
        float2 v = q[i];
        if (rest) {
            float2 snapped = {snap_tenth(v.x), snap_tenth(v.y)};
            v = snapped;
        }
        s.p[i] = v;
        float recip = near_z / c[i].z;
        lo = i == 0u || recip < lo ? recip : lo;
        hi = i == 0u || recip > hi ? recip : hi;
    }
    s.count = m;
    s.lo = lo - lo * BUILDING_PLANE_SPAN;
    s.hi = hi + hi * BUILDING_PLANE_SPAN;
    s.area = abs(twice) / 2.0f;
    for (uint i = 0u; i < m; ++i) {
        float r = building_window_plane_recip(cam, plane, s.p[i]);
        float r_lo = r - r * BUILDING_PLANE_SPAN;
        float r_hi = r + r * BUILDING_PLANE_SPAN;
        s.lo = r_lo < s.lo ? r_lo : s.lo;
        s.hi = r_hi > s.hi ? r_hi : s.hi;
    }
    return s;
}

/// Point i (0 to 29) of an arch's fan: the corner (0, t + 1, t + 2) of its triangle t, the points past its last
/// repeating it.
inline float2 building_arch_fan_point(BuildingArch a, uint i) {
    uint t = i / 3u;
    uint k = i - t * 3u;
    uint corner = k == 0u ? 0u : t + k;
    return a.p[corner < a.count ? corner : a.count - 1u];
}

/// An arch as an edged building shape on its wall's plane `plane` at `lead` (its span alone: what its depth is taken
/// over).
inline BuildingShape building_arch_as_shape(BuildingArch a, float4 plane, float lead) {
    BuildingShape s = building_nothing();
    s.count = 3u;
    s.p0 = a.p[0];
    s.p1 = a.p[1];
    s.p2 = a.p[2];
    s.plane = plane;
    s.lo = a.lo;
    s.hi = a.hi;
    s.lead = lead;
    return s;
}

// A church window's record, which windows_cs writes for each church window of the frame's jobs and church_window_vs
// reads (26 uint4): v[0] its header (its stone's corners, bits 0-3; its reveal's, 4-7; its glass's, 8-11; its leading
// drawn, bit 12), its wall's record among the frame's walls, its wall's first window slot, its transoms; v[1 + 7 p]
// to v[7 + 7 p] its arch p (0 its stone, 1 its reveal, 2 its glass): its span's ends, then its twelve corners (x, y);
// v[22] to v[25] its leading's ends in camera coordinates: the left and right ends of the transoms' lines at its sill
// and at its arch's spring, the mullion's top, and the step of a transom from the sill to the spring (a fraction). A
// header 0: nothing of it is drawn.
static const uint BUILDING_CHURCH_RECORD_VECTORS = 26u;
static const uint BUILDING_CHURCH_ARCH_VECTORS = 7u;
static const uint BUILDING_CHURCH_LEADING_AT = 22u;
static const uint BUILDING_CHURCH_LEADING_DRAWN = 4096u;

struct BuildingChurchRecord {
    uint4 v[26];
};

/// A record with nothing in it.
inline BuildingChurchRecord building_church_empty() {
    BuildingChurchRecord r;
    uint4 zero = {0u, 0u, 0u, 0u};
    for (uint i = 0u; i < BUILDING_CHURCH_RECORD_VECTORS; ++i) {
        r.v[i] = zero;
    }
    return r;
}

/// The first vector of a record's part (0 to 2 its arches, 3 its leading).
inline uint building_church_part_at(uint part) {
    return part < 3u ? 1u + part * BUILDING_CHURCH_ARCH_VECTORS : BUILDING_CHURCH_LEADING_AT;
}

/// The record of church window k (of `transoms` transoms) on wall `wall` (its face's normal `n`, its plane `plane` in
/// camera coordinates) laid out as `b`, the frame's wall record `wall_record`, its wall's first window slot `slot`.
inline BuildingChurchRecord building_church_record(FrameCamera cam, TilePlace place, BuildingPrim wall, float3 n,
                                                   float4 plane, BuildingChurchBay b, uint k, uint transoms,
                                                   uint wall_record, uint slot) {
    BuildingChurchRecord r = building_church_empty();
    BuildingArch stone = building_arch_cut(cam, place, wall, n, plane, b, k, 0.0f, BUILDING_CHURCH_STONE);
    if (stone.count == 0u || stone.area < BUILDING_CHURCH_STONE_AREA) {
        return r;
    }
    BuildingArch reveal = building_arch_cut(cam, place, wall, n, plane, b, k, 0.0f, 0.0f);
    BuildingArch glass = building_arch_cut(cam, place, wall, n, plane, b, k, BUILDING_CHURCH_GLASS, 0.0f);
    bool leading = glass.count != 0u && glass.area > BUILDING_CHURCH_LEADING_AREA;
    uint header = stone.count | (reveal.count << 4u) | (glass.count << 8u) | (leading ? BUILDING_CHURCH_LEADING_DRAWN : 0u);
    uint4 head = {header, wall_record, slot, transoms};
    r.v[0] = head;
    for (uint part = 0u; part < 3u; ++part) {
        BuildingArch a = part == 0u ? stone : (part == 1u ? reveal : glass);
        uint at = building_church_part_at(part);
        uint4 span = {asuint(a.lo), asuint(a.hi), asuint(a.p[0].x), asuint(a.p[0].y)};
        r.v[at] = span;
        for (uint i = 0u; i < 6u; ++i) {
            float2 u = a.p[1u + 2u * i];
            float2 v = a.p[0];
            if (2u + 2u * i < BUILDING_ARCH_MOST) {
                v = a.p[2u + 2u * i];
            }
            uint4 corners = {asuint(u.x), asuint(u.y), asuint(v.x), asuint(v.y)};
            r.v[at + 1u + i] = corners;
        }
    }
    // the leading's lines in camera coordinates, its points along them affine there (closeup.py projects each)
    float uc = (float(k) + 0.5f) * b.bw;
    float3 lb = camera_of(cam, eye_relative(place, building_church_point(wall, n, b, uc - b.wh, b.ys, BUILDING_CHURCH_LEADING)));
    float3 lt = camera_of(cam, eye_relative(place, building_church_point(wall, n, b, uc - b.wh, b.ye, BUILDING_CHURCH_LEADING)));
    float3 rb = camera_of(cam, eye_relative(place, building_church_point(wall, n, b, uc + b.wh, b.ys, BUILDING_CHURCH_LEADING)));
    float3 rt = camera_of(cam, eye_relative(place, building_church_point(wall, n, b, uc + b.wh, b.ye, BUILDING_CHURCH_LEADING)));
    float3 mt = camera_of(cam, eye_relative(place, building_church_point(wall, n, b, uc, b.ye + b.wh, BUILDING_CHURCH_LEADING)));
    float step = b.ye > b.ys ? BUILDING_CHURCH_TRANSOM / (b.ye - b.ys) : 0.0f;
    uint4 l0 = {asuint(lb.x), asuint(lb.y), asuint(lb.z), asuint(lt.x)};
    uint4 l1 = {asuint(lt.y), asuint(lt.z), asuint(rb.x), asuint(rb.y)};
    uint4 l2 = {asuint(rb.z), asuint(rt.x), asuint(rt.y), asuint(rt.z)};
    uint4 l3 = {asuint(mt.x), asuint(mt.y), asuint(mt.z), asuint(step)};
    r.v[BUILDING_CHURCH_LEADING_AT] = l0;
    r.v[BUILDING_CHURCH_LEADING_AT + 1u] = l1;
    r.v[BUILDING_CHURCH_LEADING_AT + 2u] = l2;
    r.v[BUILDING_CHURCH_LEADING_AT + 3u] = l3;
    return r;
}

/// A record's arch `part` (0 its stone, 1 its reveal, 2 its glass).
inline BuildingArch building_church_arch(BuildingChurchRecord r, uint part) {
    BuildingArch a = building_arch_nothing();
    a.count = (r.v[0].x >> (4u * part)) & 15u;
    uint at = building_church_part_at(part);
    uint4 span = r.v[at];
    a.lo = asfloat(span.x);
    a.hi = asfloat(span.y);
    float2 p0 = {asfloat(span.z), asfloat(span.w)};
    a.p[0] = p0;
    for (uint i = 0u; i < 6u; ++i) {
        uint4 corners = r.v[at + 1u + i];
        float2 u = {asfloat(corners.x), asfloat(corners.y)};
        a.p[1u + 2u * i] = u;
        if (2u + 2u * i < BUILDING_ARCH_MOST) {
            float2 v = {asfloat(corners.z), asfloat(corners.w)};
            a.p[2u + 2u * i] = v;
        }
    }
    return a;
}

/// Whether a record draws its leading, and how many transoms it has.
inline bool building_church_leading_drawn(BuildingChurchRecord r) {
    return (r.v[0].x & BUILDING_CHURCH_LEADING_DRAWN) != 0u;
}

/// Segment j of a record's leading (0 its mullion, from its sill's middle to its arch's top; then its transoms upward,
/// across it at 1.5 m steps from the sill) as Camera.proj gives its ends (none where either lies behind the near
/// plane), snapped at rest, with the span of their reciprocal depths widened as a shape's and to its wall's plane
/// `plane`'s at them: a sash's first bar (building_sash_bar draws it).
inline BuildingSash building_church_segment(FrameCamera cam, float4 plane, BuildingChurchRecord r, uint j) {
    BuildingSash s = building_sash_nothing();
    uint4 l0 = r.v[BUILDING_CHURCH_LEADING_AT];
    uint4 l1 = r.v[BUILDING_CHURCH_LEADING_AT + 1u];
    uint4 l2 = r.v[BUILDING_CHURCH_LEADING_AT + 2u];
    uint4 l3 = r.v[BUILDING_CHURCH_LEADING_AT + 3u];
    float3 lb = {asfloat(l0.x), asfloat(l0.y), asfloat(l0.z)};
    float3 lt = {asfloat(l0.w), asfloat(l1.x), asfloat(l1.y)};
    float3 rb = {asfloat(l1.z), asfloat(l1.w), asfloat(l2.x)};
    float3 rt = {asfloat(l2.y), asfloat(l2.z), asfloat(l2.w)};
    float3 mt = {asfloat(l3.x), asfloat(l3.y), asfloat(l3.z)};
    float step = asfloat(l3.w);
    float3 ka = (lb + rb) / 2.0f;
    float3 kb = mt;
    if (j > 0u) {
        float t = float(j) * step;
        ka = lb + (lt - lb) * t;
        kb = rb + (rt - rb) * t;
    }
    float near_z = cam.frame.w;
    if (ka.z < near_z || kb.z < near_z) {
        return s;
    }
    float2 a = css_of(cam, ka);
    float2 b = css_of(cam, kb);
    if (camera_rests(cam)) {
        float2 sa = {snap_tenth(a.x), snap_tenth(a.y)};
        float2 sb = {snap_tenth(b.x), snap_tenth(b.y)};
        a = sa;
        b = sb;
    }
    float ra = near_z / ka.z;
    float rb2 = near_z / kb.z;
    float lo = ra < rb2 ? ra : rb2;
    float hi = ra > rb2 ? ra : rb2;
    lo = lo - lo * BUILDING_PLANE_SPAN;
    hi = hi + hi * BUILDING_PLANE_SPAN;
    float2 ends[2] = {a, b};
    for (uint i = 0u; i < 2u; ++i) {
        float p = building_window_plane_recip(cam, plane, ends[i]);
        float p_lo = p - p * BUILDING_PLANE_SPAN;
        float p_hi = p + p * BUILDING_PLANE_SPAN;
        lo = p_lo < lo ? p_lo : lo;
        hi = p_hi > hi ? p_hi : hi;
    }
    s.drawn = true;
    s.m1 = a;
    s.m2 = b;
    s.h1 = a;
    s.h2 = b;
    s.lo = lo;
    s.hi = hi;
    return s;
}

/// Which part vertex v of a church window's record draws: 0 to 2 its arches (BUILDING_ARCH_VERTICES each), 3 its
/// leading.
inline uint building_church_part(uint v) {
    return v < BUILDING_CHURCH_ARCH_VERTICES ? v / BUILDING_ARCH_VERTICES : 3u;
}

/// The corner (0 to 3) of a bar's quad that vertex i (0 to 5: its triangles (0, 1, 2), (0, 2, 3)) takes.
inline uint building_bar_corner(uint i) {
    return i == 0u || i == 3u ? 0u : (i == 1u ? 1u : (i == 2u || i == 4u ? 2u : 3u));
}

/// A width in hundredths of a CSS px (the leading's, as the port prints it), as the frame draws it.
inline float building_hundredths(uint hundredths) {
    return float(hundredths) / 100.0f;
}

/// The church windows' stones' colour at the moment, and their leading's.
inline float3 building_church_stone(uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? BUILDING_CHURCH_STONE_NIGHT : BUILDING_CHURCH_STONE_DAY);
}

inline float3 building_church_leading(uint theme_flags) {
    return building_rgb((theme_flags & THEME_NIGHT) != 0u ? BUILDING_CHURCH_LEADING_NIGHT
                                                          : BUILDING_CHURCH_LEADING_DAY);
}

/// The church windows' glass as the port paints it (with weather): by day the plain windows' dark glass (the gradient
/// `glass`), by night its own flat colour.
inline BuildingGlass building_church_glass(FrameWindows w, uint theme_flags) {
    if ((theme_flags & THEME_NIGHT) != 0u) {
        BuildingGlass g;
        g.top = building_rgb(BUILDING_CHURCH_GLASS_NIGHT);
        g.bottom = g.top;
        g.gradient = false;
        return g;
    }
    return building_glass(w, theme_flags, BUILDING_WINDOW_PLAIN, 0u, false);
}

/// The church windows' glass as the frame draws it: by day with the veil folded in, each of its gradient's stops mixed
/// with #2A3038 at .42 (SVG's source-over of the veil's path over the glass's, at every point of the gradient).
inline BuildingGlass building_church_veiled(FrameWindows w, uint theme_flags) {
    BuildingGlass g = building_church_glass(w, theme_flags);
    if ((theme_flags & THEME_NIGHT) == 0u) {
        float3 veil = building_rgb(BUILDING_CHURCH_VEIL_RGB);
        g.top = g.top + (veil - g.top) * BUILDING_CHURCH_VEIL;
        g.bottom = g.bottom + (veil - g.bottom) * BUILDING_CHURCH_VEIL;
    }
    return g;
}

// ---------------------------------------------------------------------------------------------- material faces

// A wall's material face (geometry/Walls.hpp's Material; render/amsterdam.py's material_face): with weather, on a
// turned wall over 2 m (not a part's but a church's) whose item lies nearer than 1.35 times the view's win_d, after its
// shop glazing and before its windows, with fh = (top - y0) / lv, lv = max(1, levels), and ppm = focal / max(d, 1) at
// its item's depth d:
//   - glass: the wall's glass, quad_at(a, b, y0 + (0 if y0 > 0.5 else 0.4), top, 0, 1, 0.02, n) as Camera.poly gives
//     it (margin 300 px, its area over 1 px²), the gradient `glass` at .55 by day, #0E1420 at .8 at night; then one
//     path of its floors (r = 1 to lv - 1 at y0 + r·fh along the whole wall, where fh·ppm > 2.4) and its mullions (k = 1
//     to n - 1 at k / n from y0 to top, n = int(elen / step), the step 1.5 m where 1.5·ppm >= 3.2, else 3 m where
//     3·ppm >= 3.2, else none), 0.03 m out, stroked .55 px in #E4ECF0 (#2A3240 at night) at .7;
//   - metal, by day: its ribs every 1 m where ppm >= 2.6, else every 2 m where ppm >= 1.4 (k = 1 to n - 1 at k / n,
//     from y0 + 0.3 to top - 0.15), 0.03 m out, stroked .5 px in its wall's colour times .62 at .38;
//   - balconies, where fh·ppm > 2.2: the rows 2 and (from 6 storeys) lv - 1 at y0 + r·fh + 0.12, from 0.02 to 0.98
//     along the wall, 0.25 m out, stroked max(.6, .14·ppm) px (as printed) in #2E3036 (#0C0D10 at night) at .7;
//   - parking, where fh·ppm > 2.0: each deck r = 0 to lv - 1, quad_at(a, b, y0 + r·fh + 0.95, y0 + (r + 1)·fh - 0.1,
//     0.03, 0.97, 0.03, n) as Camera.poly gives it (margin 300 px, its area over 0.4 px²), #2C2F35 (#090A0D at night)
//     at .62.
// A line's ends are projected as Camera.proj projects them: one behind the near plane leaves the line out of its path.
// What the view decides the CPU decides in double (passes::material_choice), and the jobs carry it: each wall's fills
// and lines, how many, its mullions' or ribs' n or its balconies' width, its ribs' colour; windows_cs writes each fill
// and line record, drawn or not.
//
// The frame draws them after every opaque fragment (the translucent phase), at their path's slot under the painter
// switch, over what lies under them as SVG's opacity paints it (source over): the fills each once (one path's never
// meet), the lines once a sample a path (stencil bit BUILDING_MATERIAL_STENCIL: a sample takes the lines of the wall
// nearest it alone, so the first of them to reach it marks it), as SVG strokes a path. They write no depth, so their
// leads on their wall's plane place them only against what is drawn opaque there, in the port's order where it can: a
// glass wall's (which has no windows) past its shop glazing's and short of its plinth's and cornice's; any other one's
// past every cell's and short of every window part's, and so under a shop's glazing where they meet (a metal shop floor,
// a parking garage's ground deck behind its shops), which the port paints over the glazing.

/// The painter slots a wall's material face takes (geometry/Walls.hpp's material_slots): a glass wall's fill and its
/// lines, any other one's path.
inline uint building_material_slots(uint material) {
    return material == BUILDING_MATERIAL_NONE ? 0u : (material == BUILDING_MATERIAL_GLASS ? 2u : 1u);
}

/// A wall's material face's lead on its wall's plane: a glass wall's the sash bars' (past the shop glazing's glass and
/// frame, short of the plinth's and cornice's), any other one's the reveals' (past every cell's, short of every window
/// part's beside the reveals, which it ties).
inline float building_material_lead(uint material) {
    return material == BUILDING_MATERIAL_GLASS ? BUILDING_SASH_LEAD : BUILDING_REVEAL_LEAD;
}

// The port's constants (m; CSS px²): the glass's foot over a wall on the street (its foot at most 0.5 m up), how far
// it stands out, its least area (exclusive); the lines' distance out; the ribs' foot over the wall's and head under its
// top; the balconies' height over their floor, their span along the wall and how far they stand out; a deck's foot
// over its floor and head under the next one's, its span, how far it stands out, its least area (exclusive).
static const float BUILDING_MATERIAL_GLASS_FOOT = 0.4f;
static const float BUILDING_MATERIAL_STREET = 0.5f;
static const float BUILDING_MATERIAL_GLASS_OUT = 0.02f;
static const float BUILDING_MATERIAL_GLASS_AREA = 1.0f;
static const float BUILDING_MATERIAL_LINE_OUT = 0.03f;
static const float BUILDING_MATERIAL_RIB_FOOT = 0.3f;
static const float BUILDING_MATERIAL_RIB_HEAD = 0.15f;
static const float BUILDING_MATERIAL_BALCONY_UP = 0.12f;
static const float BUILDING_MATERIAL_BALCONY_U0 = 0.02f;
static const float BUILDING_MATERIAL_BALCONY_U1 = 0.98f;
static const float BUILDING_MATERIAL_BALCONY_OUT = 0.25f;
static const float BUILDING_MATERIAL_DECK_FOOT = 0.95f;
static const float BUILDING_MATERIAL_DECK_HEAD = 0.1f;
static const float BUILDING_MATERIAL_DECK_U0 = 0.03f;
static const float BUILDING_MATERIAL_DECK_U1 = 0.97f;
static const float BUILDING_MATERIAL_DECK_OUT = 0.03f;
static const float BUILDING_MATERIAL_DECK_AREA = 0.4f;
// Their paints (0xRRGGBB) and opacities: the glass's at night and its opacity by day and at night (by day it is the
// gradient `glass`); its lines' by day and at night, their width and opacity; the metal ribs' width and opacity (their
// colour is each wall's: the jobs carry it); the balconies' by day and at night and their opacity (their width is the
// view's); the decks' by day and at night and their opacity.
static const uint BUILDING_MATERIAL_GLASS_NIGHT = 0x0E1420u;
static const float BUILDING_MATERIAL_GLASS_DAY_OPACITY = 0.55f;
static const float BUILDING_MATERIAL_GLASS_NIGHT_OPACITY = 0.8f;
static const uint BUILDING_MATERIAL_LINES_DAY = 0xE4ECF0u;
static const uint BUILDING_MATERIAL_LINES_NIGHT = 0x2A3240u;
static const float BUILDING_MATERIAL_LINES_WIDTH = 0.55f;
static const float BUILDING_MATERIAL_LINES_OPACITY = 0.7f;
static const float BUILDING_MATERIAL_RIBS_WIDTH = 0.5f;
static const float BUILDING_MATERIAL_RIBS_OPACITY = 0.38f;
static const uint BUILDING_MATERIAL_BALCONIES_DAY = 0x2E3036u;
static const uint BUILDING_MATERIAL_BALCONIES_NIGHT = 0x0C0D10u;
static const float BUILDING_MATERIAL_BALCONIES_OPACITY = 0.7f;
static const uint BUILDING_MATERIAL_DECKS_DAY = 0x2C2F35u;
static const uint BUILDING_MATERIAL_DECKS_NIGHT = 0x090A0Du;
static const float BUILDING_MATERIAL_DECKS_OPACITY = 0.62f;
/// The stencil bit the material lines mark the samples they paint with (one no other pass writes:
/// passes/Ground.hpp's ground_stencil holds the others, painter.slang's OBJECTS_BIT the objects').
static const uint BUILDING_MATERIAL_STENCIL = 0x20u;
// The vertices a fill record draws (a fan of 3 triangles over its 5 corners at most) and a line record (a quad).
static const uint BUILDING_MATERIAL_FILL_VERTICES = 9u;
static const uint BUILDING_MATERIAL_LINE_VERTICES = 6u;

/// Whether a wall's material face is drawn at the frame (its face `f` and its item's rank entry `rank`): with weather,
/// its item nearer than 1.35 times win_d, its wall turned to the eye.
inline bool building_materials_drawn(uint theme_flags, TilePlace place, BuildingFace f, uint rank) {
    return rank != RANK_NONE && (theme_flags & THEME_WEATHER) != 0u &&
           (rank_detail(rank) & BUILDING_DETAIL_MATERIALS) != 0u && building_wall_turned(place, f);
}

/// A wall's glass (material_face's): quad_at(a, b, y0 + (0 if y0 > 0.5 else 0.4), top, 0, 1, 0.02, n).
inline BuildingPrim building_material_glass(BuildingPrim wall, float3 n) {
    BuildingWindowBox b;
    b.ya = wall.c0.y + (wall.c0.y > BUILDING_MATERIAL_STREET ? 0.0f : BUILDING_MATERIAL_GLASS_FOOT);
    b.yb = wall.c3.y;
    b.u0 = 0.0f;
    b.u1 = 1.0f;
    return building_window_quad(wall, n, b, BUILDING_MATERIAL_GLASS_OUT);
}

/// A parking garage's deck r of `levels` (material_face's): quad_at(a, b, y0 + r·fh + 0.95, y0 + (r + 1)·fh - 0.1,
/// 0.03, 0.97, 0.03, n).
inline BuildingPrim building_material_deck(BuildingPrim wall, float3 n, uint levels, uint r) {
    float y0 = wall.c0.y;
    float fh = (wall.c3.y - y0) / float(levels > 1u ? levels : 1u);
    BuildingWindowBox b;
    b.ya = y0 + float(r) * fh + BUILDING_MATERIAL_DECK_FOOT;
    b.yb = y0 + float(r + 1u) * fh - BUILDING_MATERIAL_DECK_HEAD;
    b.u0 = BUILDING_MATERIAL_DECK_U0;
    b.u1 = BUILDING_MATERIAL_DECK_U1;
    return building_window_quad(wall, n, b, BUILDING_MATERIAL_DECK_OUT);
}

/// A material line's ends on its wall (u along it from a to b, y up, `out` metres along its face's normal `n`).
struct BuildingMaterialEnds {
    float u0;
    float y0;
    float u1;
    float y1;
    float out;
};

/// Line k of a wall's material face `material` (its storeys `levels`; `floors` floor lines first on a glass wall; the
/// mullions' or ribs' n): a glass wall's floors (r = k + 1 at y0 + r·fh, u 0 to 1), then its mullions (k - floors + 1
/// over n, from y0 to top); a metal wall's ribs ((k + 1) / n, from y0 + 0.3 to top - 0.15); a stone front's balconies
/// (the rows 2, then lv - 1, at y0 + r·fh + 0.12, u 0.02 to 0.98, 0.25 m out).
inline BuildingMaterialEnds building_material_ends(BuildingPrim wall, uint material, uint levels, uint floors, uint n,
                                                   uint k) {
    float y0 = wall.c0.y;
    float top = wall.c3.y;
    float fh = (top - y0) / float(levels > 1u ? levels : 1u);
    BuildingMaterialEnds e;
    e.out = BUILDING_MATERIAL_LINE_OUT;
    if (material == BUILDING_MATERIAL_BALCONIES) {
        uint r = k == 0u ? 2u : levels - 1u;
        float y = y0 + float(r) * fh + BUILDING_MATERIAL_BALCONY_UP;
        e.u0 = BUILDING_MATERIAL_BALCONY_U0;
        e.u1 = BUILDING_MATERIAL_BALCONY_U1;
        e.y0 = y;
        e.y1 = y;
        e.out = BUILDING_MATERIAL_BALCONY_OUT;
        return e;
    }
    if (material == BUILDING_MATERIAL_GLASS && k < floors) {
        float y = y0 + float(k + 1u) * fh;
        e.u0 = 0.0f;
        e.u1 = 1.0f;
        e.y0 = y;
        e.y1 = y;
        return e;
    }
    uint j = material == BUILDING_MATERIAL_GLASS ? k - floors + 1u : k + 1u;
    float u = float(j) / float(n);
    bool ribs = material == BUILDING_MATERIAL_METAL;
    e.u0 = u;
    e.u1 = u;
    e.y0 = ribs ? y0 + BUILDING_MATERIAL_RIB_FOOT : y0;
    e.y1 = ribs ? top - BUILDING_MATERIAL_RIB_HEAD : top;
    return e;
}

/// A material line as the frame draws it: nothing, or its ends (CSS px, snapped at rest), with the span of their
/// reciprocal depths (widened as a shape's).
struct BuildingMaterialLine {
    bool drawn;
    float2 p0;
    float2 p1;
    float lo;
    float hi;
};

/// Line `e` of wall `wall` (its face's normal `n`) at the frame's camera: each end at a + (b - a)·u + n·out, y, projected
/// as Camera.proj does (none behind the near plane: then no line), snapped at rest.
inline BuildingMaterialLine building_material_line(FrameCamera cam, TilePlace place, BuildingPrim wall, float3 n,
                                                   BuildingMaterialEnds e) {
    BuildingMaterialLine l;
    float2 zero = {0.0f, 0.0f};
    l.drawn = false;
    l.p0 = zero;
    l.p1 = zero;
    l.lo = 0.0f;
    l.hi = 0.0f;
    float ex = wall.c1.x - wall.c0.x;
    float ez = wall.c1.z - wall.c0.z;
    float3 a = {(wall.c0.x + ex * e.u0) + n.x * e.out, e.y0, (wall.c0.z + ez * e.u0) + n.z * e.out};
    float3 b = {(wall.c0.x + ex * e.u1) + n.x * e.out, e.y1, (wall.c0.z + ez * e.u1) + n.z * e.out};
    float near_z = cam.frame.w;
    float3 k0 = camera_of(cam, eye_relative(place, a));
    float3 k1 = camera_of(cam, eye_relative(place, b));
    if (k0.z < near_z || k1.z < near_z) {
        return l;
    }
    float2 p0 = css_of(cam, k0);
    float2 p1 = css_of(cam, k1);
    if (camera_rests(cam)) {
        float2 s0 = {snap_tenth(p0.x), snap_tenth(p0.y)};
        float2 s1 = {snap_tenth(p1.x), snap_tenth(p1.y)};
        p0 = s0;
        p1 = s1;
    }
    float r0 = near_z / k0.z;
    float r1 = near_z / k1.z;
    float lo = r0 < r1 ? r0 : r1;
    float hi = r0 < r1 ? r1 : r0;
    l.drawn = true;
    l.p0 = p0;
    l.p1 = p1;
    l.lo = lo - lo * BUILDING_PLANE_SPAN;
    l.hi = hi + hi * BUILDING_PLANE_SPAN;
    return l;
}

/// Line `l` with its span widened to its wall's plane's at its ends (building_window_on_plane's).
inline BuildingMaterialLine building_material_line_on_plane(FrameCamera cam, float4 plane, BuildingMaterialLine l) {
    if (!l.drawn) {
        return l;
    }
    float2 p[2] = {l.p0, l.p1};
    for (uint i = 0u; i < 2u; ++i) {
        float r = building_window_plane_recip(cam, plane, p[i]);
        float r_lo = r - r * BUILDING_PLANE_SPAN;
        float r_hi = r + r * BUILDING_PLANE_SPAN;
        l.lo = r_lo < l.lo ? r_lo : l.lo;
        l.hi = r_hi > l.hi ? r_hi : l.hi;
    }
    return l;
}

/// Line `l` stroked `half` CSS px either side, butt-capped: a quad (no area where its ends meet), with its span
/// (building_sash_bar's).
inline BuildingWindowShape building_material_bar(BuildingMaterialLine l, float half) {
    BuildingWindowShape b = building_window_nothing();
    if (!l.drawn) {
        return b;
    }
    float2 e = l.p1 - l.p0;
    float len = sqrt(e.x * e.x + e.y * e.y);
    if (!(len > 0.0f)) {
        return b;
    }
    float2 m = {-e.y * half / len, e.x * half / len};
    b.count = 4u;
    b.p0 = l.p0 + m;
    b.p1 = l.p0 + e + m;
    b.p2 = l.p0 + e - m;
    b.p3 = l.p0 - m;
    b.p4 = b.p3;
    b.lo = l.lo;
    b.hi = l.hi;
    b.area = 2.0f * half * len;
    return b;
}

/// The paint and opacity of a wall's material face `material`'s fills (the glass, a deck) at the moment, and of its
/// lines (its ribs' colour `ribs`, 0xRRGGBB): by day a glass wall's fill is the gradient `glass` (BuildingGlass's).
struct BuildingMaterialPaint {
    BuildingGlass paint;
    float opacity;
};

inline BuildingMaterialPaint building_material_fill(FrameWindows w, uint theme_flags, uint material) {
    BuildingMaterialPaint p;
    bool night = (theme_flags & THEME_NIGHT) != 0u;
    if (material == BUILDING_MATERIAL_GLASS && !night) {
        p.paint = building_glass(w, theme_flags, BUILDING_WINDOW_PLAIN, 0u, false);
        p.opacity = BUILDING_MATERIAL_GLASS_DAY_OPACITY;
        return p;
    }
    uint c = material == BUILDING_MATERIAL_GLASS
                 ? BUILDING_MATERIAL_GLASS_NIGHT
                 : (night ? BUILDING_MATERIAL_DECKS_NIGHT : BUILDING_MATERIAL_DECKS_DAY);
    p.paint.top = building_rgb(c);
    p.paint.bottom = p.paint.top;
    p.paint.gradient = false;
    p.opacity = material == BUILDING_MATERIAL_GLASS ? BUILDING_MATERIAL_GLASS_NIGHT_OPACITY
                                                    : BUILDING_MATERIAL_DECKS_OPACITY;
    return p;
}

inline BuildingMaterialPaint building_material_lines(uint theme_flags, uint material, uint ribs) {
    BuildingMaterialPaint p;
    bool night = (theme_flags & THEME_NIGHT) != 0u;
    uint c = ribs;
    p.opacity = BUILDING_MATERIAL_RIBS_OPACITY;
    if (material == BUILDING_MATERIAL_GLASS) {
        c = night ? BUILDING_MATERIAL_LINES_NIGHT : BUILDING_MATERIAL_LINES_DAY;
        p.opacity = BUILDING_MATERIAL_LINES_OPACITY;
    } else if (material == BUILDING_MATERIAL_BALCONIES) {
        c = night ? BUILDING_MATERIAL_BALCONIES_NIGHT : BUILDING_MATERIAL_BALCONIES_DAY;
        p.opacity = BUILDING_MATERIAL_BALCONIES_OPACITY;
    }
    p.paint.top = building_rgb(c);
    p.paint.bottom = p.paint.top;
    p.paint.gradient = false;
    return p;
}

/// A wall's material lines' width (CSS px): a glass wall's .55, a metal one's .5, a stone front's balconies' as the
/// jobs give it (`width`, hundredths as the port prints it).
inline float building_material_width(uint material, uint width) {
    if (material == BUILDING_MATERIAL_GLASS) {
        return BUILDING_MATERIAL_LINES_WIDTH;
    }
    if (material == BUILDING_MATERIAL_METAL) {
        return BUILDING_MATERIAL_RIBS_WIDTH;
    }
    return building_hundredths(width);
}

// A material fill's record (4 uint4), which windows_cs writes and material_fill_vs reads: v0 its corners' count (bits
// 0-2: none drawn where 0) and its wall's material face (4-6), its wall's record among the frame's walls, its path's
// painter slot; then its span and its five corners. A line's (3 uint4), which material_line_vs reads: v0 its wall's
// material face (bits 4-6; bit 0 set where it is drawn), its wall's record, its path's slot, its ribs' colour or its
// width in hundredths (a balcony's); v1 its ends; v2 its span.
static const uint BUILDING_MATERIAL_FILL_VECTORS = 4u;
static const uint BUILDING_MATERIAL_LINE_VECTORS = 3u;

struct BuildingMaterialFillRecord {
    uint4 v0;
    uint4 v1;
    uint4 v2;
    uint4 v3;
};

inline BuildingMaterialFillRecord building_material_fill_record(BuildingWindowShape s, uint material, uint wall,
                                                                uint slot) {
    BuildingMaterialFillRecord r;
    uint4 v0 = {s.count | (material << 4u), wall, slot, 0u};
    uint4 v1 = {asuint(s.lo), asuint(s.hi), asuint(s.p0.x), asuint(s.p0.y)};
    uint4 v2 = {asuint(s.p1.x), asuint(s.p1.y), asuint(s.p2.x), asuint(s.p2.y)};
    uint4 v3 = {asuint(s.p3.x), asuint(s.p3.y), asuint(s.p4.x), asuint(s.p4.y)};
    r.v0 = v0;
    r.v1 = v1;
    r.v2 = v2;
    r.v3 = v3;
    return r;
}

/// A fill record's shape (its area not kept).
inline BuildingWindowShape building_material_fill_shape(BuildingMaterialFillRecord r) {
    BuildingWindowShape s = building_window_nothing();
    s.count = r.v0.x & 7u;
    s.lo = asfloat(r.v1.x);
    s.hi = asfloat(r.v1.y);
    float2 p0 = {asfloat(r.v1.z), asfloat(r.v1.w)};
    float2 p1 = {asfloat(r.v2.x), asfloat(r.v2.y)};
    float2 p2 = {asfloat(r.v2.z), asfloat(r.v2.w)};
    float2 p3 = {asfloat(r.v3.x), asfloat(r.v3.y)};
    float2 p4 = {asfloat(r.v3.z), asfloat(r.v3.w)};
    s.p0 = p0;
    s.p1 = p1;
    s.p2 = p2;
    s.p3 = p3;
    s.p4 = p4;
    return s;
}

struct BuildingMaterialLineRecord {
    uint4 v0;
    uint4 v1;
    uint4 v2;
};

inline BuildingMaterialLineRecord building_material_line_record(BuildingMaterialLine l, uint material, uint wall,
                                                                uint slot, uint style) {
    BuildingMaterialLineRecord r;
    uint4 v0 = {(l.drawn ? 1u : 0u) | (material << 4u), wall, slot, style};
    uint4 v1 = {asuint(l.p0.x), asuint(l.p0.y), asuint(l.p1.x), asuint(l.p1.y)};
    uint4 v2 = {asuint(l.lo), asuint(l.hi), 0u, 0u};
    r.v0 = v0;
    r.v1 = v1;
    r.v2 = v2;
    return r;
}

inline BuildingMaterialLine building_material_line_of(BuildingMaterialLineRecord r) {
    BuildingMaterialLine l;
    l.drawn = (r.v0.x & 1u) != 0u;
    float2 p0 = {asfloat(r.v1.x), asfloat(r.v1.y)};
    float2 p1 = {asfloat(r.v1.z), asfloat(r.v1.w)};
    l.p0 = p0;
    l.p1 = p1;
    l.lo = asfloat(r.v2.x);
    l.hi = asfloat(r.v2.y);
    return l;
}

// ---------------------------------------------------------------------------------------------- hoist beams

// A hoist beam under an old gable (geometry/Walls.hpp's RoofBeam; render/amsterdam.py's _draw_building): with weather,
// its building's item nearer than 260 m and its gable turned to the eye, its ends projected as Camera.proj projects them
// (a beam with an end behind the near plane is not drawn) and snapped at rest, stroked its width (max(0.5, 0.12 · focal
// / d) as printed: the CPU's, passes::beam_width) in #2A221C with round caps: a capsule whose fragments keep the samples
// within half its width of its segment, at its slot among its roof's slopes under the painter switch, else at its true
// depth along it (its ends' reciprocal depths, the nearer end's past its round cap) with the sills' lead, over its gable
// where it leaves it. The CPU writes each record the frame draws (6 uint4): v0 its start (tile-local float bits) and
// its painter slot; v1 its end and its width in hundredths; v2 and v3 its gable's normal and test point (its turn); v4
// and v5 its tile's place.
static const uint BUILDING_BEAM_RGB = 0x2A221Cu;
static const uint BUILDING_BEAM_VECTORS = 6u;
static const uint BUILDING_BEAM_VERTICES = 6u;

/// A hoist beam as the frame draws it: nothing, or its ends (CSS px, snapped at rest), their reciprocal depths, half its
/// width (CSS px) and its painter slot.
struct BuildingBeam {
    bool drawn;
    float2 p0;
    float2 p1;
    float r0;
    float r1;
    float half;
    uint slot;
};

/// The beam of record v0 to v5 at the frame's camera.
inline BuildingBeam building_beam(FrameCamera cam, uint4 v0, uint4 v1, uint4 v2, uint4 v3, uint4 v4, uint4 v5) {
    BuildingBeam b;
    float2 zero = {0.0f, 0.0f};
    b.drawn = false;
    b.p0 = zero;
    b.p1 = zero;
    b.r0 = 0.0f;
    b.r1 = 0.0f;
    b.half = 0.5f * building_hundredths(v1.w);
    b.slot = v0.w;
    TilePlace place;
    float4 offset = {asfloat(v4.x), asfloat(v4.y), asfloat(v4.z), asfloat(v4.w)};
    float4 scale = {asfloat(v5.x), asfloat(v5.y), asfloat(v5.z), asfloat(v5.w)};
    place.offset = offset;
    place.scale = scale;
    // its gable turned to the eye (building_wall_turned's `vdot(nrm, vsub(cam.C, centre)) > 0`)
    float3 n = {asfloat(v2.x), asfloat(v2.y), asfloat(v2.z)};
    float3 test = {asfloat(v3.x), asfloat(v3.y), asfloat(v3.z)};
    float3 t = eye_relative(place, test);
    float toward = -(((n.x * t.x) + (n.y * t.y)) + (n.z * t.z));
    if (!(toward > 0.0f)) {
        return b;
    }
    float near_z = cam.frame.w;
    float3 from = {asfloat(v0.x), asfloat(v0.y), asfloat(v0.z)};
    float3 to = {asfloat(v1.x), asfloat(v1.y), asfloat(v1.z)};
    float3 k0 = camera_of(cam, eye_relative(place, from));
    float3 k1 = camera_of(cam, eye_relative(place, to));
    if (k0.z < near_z || k1.z < near_z) {
        return b;
    }
    float2 p0 = css_of(cam, k0);
    float2 p1 = css_of(cam, k1);
    if (camera_rests(cam)) {
        float2 s0 = {snap_tenth(p0.x), snap_tenth(p0.y)};
        float2 s1 = {snap_tenth(p1.x), snap_tenth(p1.y)};
        p0 = s0;
        p1 = s1;
    }
    b.drawn = true;
    b.p0 = p0;
    b.p1 = p1;
    b.r0 = near_z / k0.z;
    b.r1 = near_z / k1.z;
    return b;
}

/// A beam's direction along it (from its start; along x where its ends meet), and its length (CSS px).
inline float3 building_beam_along(BuildingBeam b) {
    float2 e = b.p1 - b.p0;
    float len = sqrt(e.x * e.x + e.y * e.y);
    float3 u = {1.0f, 0.0f, 0.0f};
    if (len > 0.0f) {
        u.x = e.x / len;
        u.y = e.y / len;
    }
    u.z = len;
    return u;
}

/// Corner c of the quad a beam draws (0 and 3 past its start, 1 and 2 past its end, 0 and 1 on its right): its segment
/// grown by half its width and a pixel's margin either way.
inline float2 building_beam_corner(BuildingBeam b, uint c) {
    float3 u = building_beam_along(b);
    float reach = b.half + 1.0f;
    float2 along = {u.x * reach, u.y * reach};
    float2 across = {-u.y * reach, u.x * reach};
    float2 p = c == 0u || c == 3u ? b.p0 - along : b.p1 + along;
    return c < 2u ? p - across : p + across;
}

/// A beam's reciprocal depth at CSS point `p`: its ends' interpolated along it (affine on the screen along a line in
/// space), each end's held past its round cap.
inline float building_beam_recip(BuildingBeam b, float2 p) {
    float3 u = building_beam_along(b);
    if (!(u.z > 0.0f)) {
        return b.r0;
    }
    float s = ((p.x - b.p0.x) * u.x + (p.y - b.p0.y) * u.y) / u.z;
    s = s < 0.0f ? 0.0f : (s > 1.0f ? 1.0f : s);
    return b.r0 + (b.r1 - b.r0) * s;
}

/// Whether CSS point `p` lies within half a beam's width of its segment (its round caps included).
inline bool building_beam_covers(BuildingBeam b, float2 p) {
    float3 u = building_beam_along(b);
    float s = u.z > 0.0f ? ((p.x - b.p0.x) * u.x + (p.y - b.p0.y) * u.y) : 0.0f;
    s = s < 0.0f ? 0.0f : (s > u.z ? u.z : s);
    float dx = p.x - (b.p0.x + u.x * s);
    float dy = p.y - (b.p0.y + u.y * s);
    return dx * dx + dy * dy <= b.half * b.half;
}
