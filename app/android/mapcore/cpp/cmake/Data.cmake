# Data files compiled into the core (ENGINE.md design point 3): the engine's style file, which every pack and window
# the core builds carries in its `style` section as the packer writes it. Each file becomes gen/data/<symbol>.hpp under
# the build directory: atlas::data::<symbol>, its bytes, and their SHA-256. The header is written when CMake configures
# and again whenever the file changes (an edit makes the build configure again), and only when its text changes.
include_guard(GLOBAL)

function(atlas_embed_data symbol input)
    file(RELATIVE_PATH _relative "${CMAKE_CURRENT_SOURCE_DIR}/../../../.." "${input}")
    file(READ "${input}" _hex HEX)
    string(LENGTH "${_hex}" _hex_length)
    math(EXPR _bytes "${_hex_length} / 2")
    if(_bytes EQUAL 0)
        message(FATAL_ERROR "${input} is empty.")
    endif()
    # sixteen bytes to a line
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _body "${_hex}")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 16 _line)
    string(REGEX REPLACE "(${_line})" "\\1\n    " _body "${_body}")
    string(REGEX REPLACE "\n    $" "" _body "${_body}")
    file(SHA256 "${input}" _sha256)

    set(_text "// Generated by cmake/Data.cmake from ${_relative}. Do not edit.\n")
    string(APPEND _text "#pragma once\n\n#include <array>\n#include <cstdint>\n#include <string_view>\n\n")
    string(APPEND _text "namespace atlas::data {\n\n")
    string(APPEND _text "/// ${_relative}, ${_bytes} bytes.\n")
    string(APPEND _text "inline constexpr std::array<std::uint8_t, ${_bytes}> ${symbol} = {\n    ${_body}\n};\n\n")
    string(APPEND _text "/// The SHA-256 of ${symbol}'s bytes.\n")
    string(APPEND _text "inline constexpr std::string_view ${symbol}_sha256 = \"${_sha256}\";\n\n")
    string(APPEND _text "} // namespace atlas::data\n")

    set(_output "${CMAKE_BINARY_DIR}/gen/data/${symbol}.hpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    if(EXISTS "${_output}")
        file(READ "${_output}" _old)
        if(_old STREQUAL _text)
            return()
        endif()
    endif()
    file(WRITE "${_output}" "${_text}")
endfunction()
