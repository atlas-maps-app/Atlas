# Embeds a SPIR-V module in the core as a constexpr array of words (plan-vector T6), with its size and SHA-256.
# Script mode, run by the build after each shader compiles:
#   cmake -DINPUT=<module.spv> -DOUTPUT=<header.hpp> -DSYMBOL=<name> -DSOURCE=<file.slang> -P Embed.cmake
cmake_minimum_required(VERSION 3.28...4.1)

foreach(_var INPUT OUTPUT SYMBOL SOURCE)
    if(NOT DEFINED ${_var})
        message(FATAL_ERROR "Embed.cmake needs -D${_var}=...")
    endif()
endforeach()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hex_length)
math(EXPR _remainder "${_hex_length} % 8")
if(_hex_length EQUAL 0 OR NOT _remainder EQUAL 0)
    message(FATAL_ERROR "${INPUT} is not a whole number of 32-bit words.")
endif()
string(SUBSTRING "${_hex}" 0 8 _magic)
if(NOT _magic STREQUAL "03022307")
    message(FATAL_ERROR "${INPUT} is not a little-endian SPIR-V module (magic ${_magic}).")
endif()
math(EXPR _words "${_hex_length} / 8")

# Each little-endian word b0 b1 b2 b3 becomes 0xb3b2b1b0u; eight words to a line.
string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1u," _body "${_hex}")
string(REGEX REPLACE "((0x[0-9a-f]+u,){8})" "\\1\n    " _body "${_body}")
string(REGEX REPLACE "\n    $" "" _body "${_body}")
file(SHA256 "${INPUT}" _sha256)

set(_text "// Generated by cmake/Embed.cmake from ${SOURCE}. Do not edit.\n")
string(APPEND _text "#pragma once\n\n#include <array>\n#include <cstdint>\n#include <string_view>\n\n")
string(APPEND _text "namespace atlas::spirv {\n\n")
string(APPEND _text "/// SPIR-V of ${SOURCE}, ${_words} words.\n")
string(APPEND _text "inline constexpr std::array<std::uint32_t, ${_words}> ${SYMBOL} = {\n    ${_body}\n};\n\n")
string(APPEND _text "/// The SHA-256 of ${SYMBOL}'s bytes (the module's entry in its spirv.lock).\n")
string(APPEND _text "inline constexpr std::string_view ${SYMBOL}_sha256 = \"${_sha256}\";\n\n")
string(APPEND _text "} // namespace atlas::spirv\n")

# Rewrite only when the text changes, so an unchanged module does not rebuild what includes it.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
    if(_old STREQUAL _text)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${_text}")
