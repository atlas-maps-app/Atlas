# Atlas is public at https://github.com/atlas-maps-app/Atlas (13 Oct 2026); what is listed here never goes there.
.DS_Store
.claude/.cc-writes/

# Data too big for git: records of the one real day that cannot be fetched again, and downloads the fetchers remake (README: Data)
data/live/rec_*/
data/transit/*.zip
data/traffic/flat_wide.json
data/regions/*/raw.json
data/regions/*/dem*.json

# The optional Google module and the two boards made from its data stay out of git (owner, 9 Oct 2026)
google/
canvas/project/EatGoogle.dc.html
canvas/project/HouseCards.dc.html

# Everything generated and remakeable (delete the folder any time; the scripts make it again)
cache/
canvas/_deleted/
qa/pagetest/runner
*.png
*.jpg
*.jpeg
*.pdf
*.pb
*.zip
*.mp4
*.mov
# but the app's test references are kept: Safari's pictures of the probe SVGs, which CI compares the drawing against, and photo fixtures
!app/android/*/src/test/resources/**/*.png
!app/android/*/src/test/resources/**/*.jpg

# The owner's own instructions file stays on this Mac
Instructions.rtf

